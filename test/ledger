#!/usr/bin/env bash
# Runs template/cordee/bin/ledger against throwaway repos and a fake cockpit. Usage: bash test/ledger [test_name...]
set -u

kit=$(cd "$(dirname "$0")/.." && pwd)
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Dev GIT_AUTHOR_EMAIL=dev@example.test GIT_COMMITTER_NAME=Dev GIT_COMMITTER_EMAIL=dev@example.test

# A remote, and a clone of it in $tmp/a with the harness and two modules, search and import.
# The fake cockpit prints $tmp/usage and keeps its arguments in $tmp/args.
setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  git -c init.defaultBranch=main init -q --bare "$tmp/origin.git"
  git clone -q "$tmp/origin.git" "$tmp/a" 2> /dev/null && cd "$tmp/a"
  mkdir -p cordee/bin cordee/modules src/search src/import
  cp -R "$kit/template/cordee/bin/." cordee/bin/
  printf 'echo "$@" > "%s/args"\ncat "%s/usage"\n' "$tmp" "$tmp" > cordee/bin/cockpit
  printf -- '---\ngoverns: [src/search]\n---\n# search\n' > cordee/modules/search.md
  printf -- '---\ngoverns: [src/import]\n---\n# import\n' > cordee/modules/import.md
  echo one | tee src/search/a.py > src/import/a.py
  git add -A
  GIT_COMMITTER_DATE=2026-10-23T10:00:00Z git commit -qm 'Adopt Cordee'
  git push -q origin HEAD:main
}

# Commits a change of $1 lines to search and $2 to import at time $3, then records it.
batch() {
  # BSD seq counts down: `seq 0` prints 1 and 0.
  [ "$1" -eq 0 ] || seq "$1" >> src/search/a.py
  [ "$2" -eq 0 ] || seq "$2" >> src/import/a.py
  git add -A
  GIT_COMMITTER_DATE=$3 git commit -qm batch -m 'Agent-Assisted: yes'
  bash cordee/bin/ledger record
}

ledger() { git ls-tree -r "${1:-refs/notes/cordee-ledger}" | awk '{ print $3 }' | git cat-file --batch | grep '^v1'; }
fails() { if [ "$1" != "$2" ]; then printf '    expected: %s\n    got:      %s\n' "$2" "$1"; return 1; fi; }

test_record_splits_a_batch_by_module_on_no_commit() {
  printf 'writer\topus\t4\t40\t400\t4000\t8\n' > "$tmp/usage"
  batch 3 1 2026-10-23T11:00:00Z
  fails "$(ledger | tr '\t' ' ')" 'v1 2026-10 import writer opus 1 10 100 1000 2
v1 2026-10 search writer opus 3 30 300 3000 6'
  # Epoch seconds: git 2.55 writes UTC as Z, older versions as +00:00.
  fails "$(git log -1 --format='%an %at %ct' refs/notes/cordee-ledger)" 'cordee 1790812800 1790812800'
  ! git notes --ref cordee-ledger list HEAD 2> /dev/null
}

# Each count splits whole: a module gets one more by the largest remainder, the first in the list on a tie, so the
# parts sum to the count.
test_record_splits_a_lone_call_without_losing_it() {
  printf 'writer\topus\t1\t3\t5\t0\t2\n' > "$tmp/usage"
  batch 2 1 2026-10-23T11:00:00Z
  fails "$(ledger | tr '\t' ' ')" 'v1 2026-10 import writer opus 0 1 2 0 1
v1 2026-10 search writer opus 1 2 3 0 1'
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 1 2026-10-23T12:00:00Z
  fails "$(ledger | tr '\t' ' ' | grep -c ' 1 1 1 1 1$')" 1
  fails "$(ledger | tr '\t' ' ' | grep ' 1 1 1 1 1$' | cut -d' ' -f3)" import
}

test_a_batch_outside_the_modules_goes_to_a_dash() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  echo doc > README.md
  git add -A
  git commit -qm doc
  bash cordee/bin/ledger record
  fails "$(ledger | cut -f3)" '-'
}

# What the quiz learns about a dev stays on their machine.
test_record_never_notes_the_quiz() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  seq 3 >> src/search/a.py
  git add -A
  fp=$(bash cordee/bin/cordee fingerprint | sed -n 's/^fingerprint: //p')
  mkdir -p .git/cordee
  printf 'v1\t1792752000\tpass\t%s\tsearch\t1\t2\tunclear\tHow?\ttoo long\n' "$fp" > .git/cordee/quiz-journal
  batch 0 0 2026-10-23T11:00:00Z
  fails "$(ledger | cut -f3)" 'search'
  ! git ls-tree -r refs/notes/cordee-ledger | awk '{ print $3 }' | git cat-file --batch | grep -e How -e unclear
}

test_an_amend_counts_from_the_last_record() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  GIT_COMMITTER_DATE=2026-10-23T12:00:00Z git commit -q --amend -m again
  bash cordee/bin/ledger record
  fails "$(cut -d' ' -f3-4 "$tmp/args")" '1792753200 1792756800'
}

test_a_failed_cockpit_loses_no_window() {
  cp cordee/bin/cockpit "$tmp/cockpit"
  echo 'exit 1' > cordee/bin/cockpit
  if batch 1 0 2026-10-23T11:00:00Z; then return 1; fi
  cp "$tmp/cockpit" cordee/bin/cockpit
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T12:00:00Z
  fails "$(cut -d' ' -f3-4 "$tmp/args")" '1792749600 1792756800'
}

test_a_dev_who_turns_it_off_notes_nothing() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  git config cordee.ledger false
  batch 1 0 2026-10-23T11:00:00Z
  ! git rev-parse -q --verify refs/notes/cordee-ledger
}

test_sync_merges_two_devs_ledgers() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  git clone -q "$tmp/origin.git" "$tmp/b" 2> /dev/null
  bash cordee/bin/ledger sync
  cd "$tmp/b"
  printf 'reviewer\tsonnet\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 0 1 2026-10-23T12:00:00Z
  bash cordee/bin/ledger sync
  git fetch -q origin refs/notes/cordee-ledger:refs/remotes/ledger
  fails "$(ledger refs/remotes/ledger | cut -f3-4 | sort | tr '\t' ' ')" 'import reviewer
search writer'
  # One commit with no parent: nothing tells whose notes came first.
  fails "$(git rev-list --parents refs/remotes/ledger)" "$(git rev-parse refs/remotes/ledger)"
  # The other dev merges it back with their next note, without a shared history.
  cd "$tmp/a"
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T13:00:00Z
  bash cordee/bin/ledger sync
  fails "$(ledger refs/notes/cordee-ledger | wc -l | tr -d ' ')" 3
}

# Keys are random, but if one ever held two notes, the merge keeps both and the next syncs still go through.
test_sync_merges_two_notes_on_one_key() {
  key=$(echo key | git hash-object --stdin)
  git notes --ref cordee-ledger add -m "$(printf 'v1\t2026-10\tsearch\twriter\topus\t1\t1\t1\t1\t1')" "$key"
  git clone -q "$tmp/origin.git" "$tmp/b" 2> /dev/null
  bash cordee/bin/ledger sync
  cd "$tmp/b"
  git notes --ref cordee-ledger add -m "$(printf 'v1\t2026-10\timport\twriter\topus\t1\t1\t1\t1\t1')" "$key"
  fails "$(bash cordee/bin/ledger sync 2>&1)" ''
  fails "$(ledger | cut -f3 | tr '\n' ' ')" 'import search '
  cd "$tmp/a"
  git notes --ref cordee-ledger add -m "$(printf 'v1\t2026-10\tsearch\treviewer\tsonnet\t1\t1\t1\t1\t1')" \
    "$(echo other | git hash-object --stdin)"
  fails "$(bash cordee/bin/ledger sync 2>&1)" ''
  fails "$(ledger | wc -l | tr -d ' ')" 3
}

test_sync_without_a_ledger_fetches_nothing() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  bash cordee/bin/ledger sync
  git clone -q "$tmp/origin.git" "$tmp/b" 2> /dev/null && cd "$tmp/b"
  bash cordee/bin/ledger sync
  ! git rev-parse -q --verify refs/notes/cordee-ledger-remote
}

# A remote out of reach shows whether sync tried: a fetch fails without a word, a push says so.
test_sync_sends_only_notes_a_remote_has_not_seen() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  bash cordee/bin/ledger sync
  git remote set-url origin "$tmp/gone.git"
  fails "$(bash cordee/bin/ledger sync 2>&1)" ''
  git -c init.defaultBranch=main init -q --bare "$tmp/mirror.git"
  git remote add mirror "$tmp/mirror.git"
  bash cordee/bin/ledger sync mirror
  git ls-remote --exit-code mirror refs/notes/cordee-ledger > /dev/null
  batch 1 0 2026-10-23T12:00:00Z
  bash cordee/bin/ledger sync origin 2>&1 | grep -qF 'did not reach origin'
}

test_installed_hooks_record_and_share_the_ledger() {
  echo 'tokens: true' > cordee/config.yml
  bash cordee/bin/cordee install-hook > /dev/null
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  echo two >> src/search/a.py
  git add -A
  git commit -qm 'Change search' 2> /dev/null
  git push -q origin HEAD:main
  git ls-remote --exit-code origin refs/notes/cordee-ledger > /dev/null
}

test_report_sums_by_month_module_role_and_model_then_shows_coverage() {
  printf 'writer\topus\t4\t40\t400\t4000\t8\n' > "$tmp/usage"
  batch 3 1 2026-10-23T11:00:00Z
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T12:00:00Z
  printf 'reviewer\tsonnet\t1\t2\t3\t4\t5\n' > "$tmp/usage"
  batch 1 0 2026-11-02T10:00:00Z
  GIT_COMMITTER_DATE=2026-11-02T11:00:00Z git commit -q --allow-empty -m 'Not noted' -m 'Agent-Assisted: yes'
  GIT_COMMITTER_DATE=2026-11-02T12:00:00Z git commit -q --allow-empty -m 'Not noted' \
    -m 'Co-Authored-By: Claude <noreply@anthropic.com>'
  fails "$(bash cordee/bin/ledger report | tr '\t' ' ')" \
    'month module role model calls input output cache_read cache_write
2026-10 import writer opus 1 10 100 1000 2
2026-10 search writer opus 4 31 301 3001 7
2026-11 search reviewer sonnet 1 2 3 4 5

month batches agent_commits
2026-10 2 2
2026-11 1 3'
}

test_report_without_a_ledger_says_how_to_fetch_it() {
  if bash cordee/bin/ledger report 2> "$tmp/err"; then return 1; fi
  grep -qF 'git fetch origin refs/notes/cordee-ledger:refs/notes/cordee-ledger' "$tmp/err"
}

test_ledger_survives_a_crlf_checkout() {
  cp "$kit/template/.gitattributes" .gitattributes
  git add -A
  git commit -qm 'Pin line ends'
  git config core.autocrlf true
  rm cordee/bin/ledger
  git checkout -- cordee/bin/ledger
  if bash cordee/bin/ledger report 2> "$tmp/err"; then return 1; fi
  grep -qF 'No token ledger here.' "$tmp/err"
}

names=${*:-$(declare -F | awk '$3 ~ /^test_/ { print $3 }')}
failed=0
for t in $names; do
  ( set -e; setup; "$t" )
  # Quiet when green: the agent that runs the tests reads every line.
  if [ $? -ne 0 ]; then echo "FAIL $t"; failed=$((failed + 1)); fi
done
echo "$failed failed of $(wc -w <<< "$names" | tr -d ' ')"
[ "$failed" -eq 0 ]
