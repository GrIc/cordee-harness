#!/usr/bin/env bash
# Runs template/sdd/bin/sdd against throwaway git repos. Usage: bash test/run [test_name...]
set -u

kit=$(cd "$(dirname "$0")/.." && pwd)
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Dev GIT_AUTHOR_EMAIL=dev@example.test GIT_COMMITTER_NAME=Dev GIT_COMMITTER_EMAIL=dev@example.test

contract() { printf -- '---\ngoverns: [%s]\n---\n# %s\n' "$2" "$1" > "sdd/modules/$1.md"; }

# An empty repo in $tmp/$1, the working directory from then on.
new_repo() { mkdir "$tmp/$1" && cd "$tmp/$1" && git -c init.defaultBranch=main init -q; }

# A repo with the harness and two contracts, search and import, each governing its src/ folder.
setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  new_repo repo
  git config core.autocrlf false
  mkdir -p sdd/bin sdd/modules src/search src/import
  cp -R "$kit/template/sdd/bin/." sdd/bin/
  contract search src/search/
  contract import src/import
  echo one > src/search/a.py
  echo one > src/import/a.py
  git add -A
  git commit -qm 'Adopt SDD-Fabrik'
  bash sdd/bin/sdd install-hook > /dev/null
  msg=$tmp/msg
  out=$tmp/out
}

succeeds() { "$@" > "$out" 2>&1 || { echo "    expected success: $*"; sed 's/^/    | /' "$out"; return 1; }; }
fails() { if "$@" > "$out" 2>&1; then echo "    expected failure: $*"; sed 's/^/    | /' "$out"; return 1; fi; }
says() { grep -qF -- "$1" "$out" || { echo "    output lacks: $1"; sed 's/^/    | /' "$out"; return 1; }; }
lacks() { if grep -qF -- "$1" "$out"; then echo "    output has: $1"; sed 's/^/    | /' "$out"; return 1; fi; }
agent_commit() { git commit -q -m "$1" -m 'Agent-Assisted: yes'; }

test_agent_drift_blocks() {
  echo two >> src/search/a.py
  git add -A
  fails agent_commit 'Change search'
  says 'DRIFT sdd/modules/search.md: src/search/a.py changed, its contract did not.'
}

test_human_drift_warns_and_commits() {
  echo two >> src/search/a.py
  git add -A
  succeeds git commit -qm 'Change search'
  says 'DRIFT sdd/modules/search.md'
  [ "$(git log -1 --format=%s)" = 'Change search' ]
}

test_spec_unchanged_spares_its_module_only() {
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  printf 'Rename\n\nAgent-Assisted: yes\nSpec-Unchanged(search): renames only\n' > "$msg"
  fails bash sdd/bin/sdd audit --message "$msg"
  says 'DRIFT sdd/modules/import.md'
  lacks 'DRIFT sdd/modules/search.md'
}

test_a_spared_module_does_not_count_toward_the_module_limit() {
  echo 'More intent.' >> sdd/modules/search.md
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  printf 'Change search\n\nAgent-Assisted: yes\nSpec-Unchanged(import): renames only\n' > "$msg"
  succeeds bash sdd/bin/sdd audit --message "$msg"
}

test_errors_stop_even_a_human_commit() {
  echo two >> src/search/a.py
  git add -A
  fails git commit -qm 'Change search' -m 'Spec-Unchanged(serch): typo'
  says 'ERROR Spec-Unchanged(serch): no such module. Modules: import, search.'
  contract import ''
  git add -A
  fails git commit -qm 'Change search'
  says 'ERROR sdd/modules/import.md: governs is empty.'
}

test_multiline_governs_is_read_fully() {
  printf -- '---\ngoverns:\n  [\n    src/search/a.py,\n    lib/search/,\n  ]\ndepends: [import]\n---\n# search\n' \
    > sdd/modules/search.md
  git add -A
  git commit -qm 'Reshape the contract'
  mkdir -p lib/search
  echo one > lib/search/b.py
  git add -A
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/search.md: lib/search/b.py changed'
}

test_merge_is_not_checked() {
  git checkout -qb side
  echo two >> src/import/a.py
  git add -A
  git commit -qm 'Side' 2> /dev/null
  git checkout -q main
  echo two >> src/search/a.py
  git add -A
  git commit -qm 'Main' 2> /dev/null
  succeeds git merge -q --no-ff side -m 'Merge side' -m 'Agent-Assisted: yes'
}

test_first_commit_of_a_repo() {
  new_repo new
  mkdir -p sdd/bin
  cp -R "$kit/template/sdd/bin/." sdd/bin/
  bash sdd/bin/sdd install-hook > /dev/null
  git add -A
  succeeds git commit -qm 'Start'
}

test_install_hook_respects_an_existing_hook() {
  hook=$(git rev-parse --git-path hooks)/commit-msg
  printf '#!/bin/sh\nexit 0\n' > "$hook"
  fails bash sdd/bin/sdd install-hook
  says 'bash sdd/bin/sdd hook "$1"'
  says "Installed $(git rev-parse --git-path hooks)/pre-push."
  says 'git config sdd.ledger false stops it.'
  grep -qx '/QUIZ.md' "$(git rev-parse --git-path info/exclude)"
}

test_install_hook_adds_the_ledger_hooks_that_pass_without_it() {
  hooks=$(git rev-parse --git-path hooks)
  line='[ ! -f sdd/bin/sdd ] || bash sdd/bin/sdd committed; [ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger record'
  grep -qxF "$line" "$hooks/post-commit"
  grep -qxF '[ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger sync "$1"' "$hooks/pre-push"
  git init -q --bare "$tmp/origin.git"
  succeeds git push -q "$tmp/origin.git" HEAD:main
}

# A shared hook (core.hooksPath) runs in every repo: the line install-hook prints must block here and pass elsewhere.
test_the_line_for_a_shared_hook() {
  git config core.hooksPath "$tmp/hooks"
  fails bash sdd/bin/sdd install-hook
  says "Your commit-msg hook is $(git rev-parse --git-path hooks)/commit-msg"
  says '[ ! -f sdd/bin/sdd ] || bash sdd/bin/sdd committed; [ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger record'
  says '[ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger sync "$1"'
  mkdir "$tmp/hooks"
  { echo '#!/bin/sh'; sed -n '/commit-msg hook/{n;p;}' "$out"; echo 'echo other checks pass'; } \
    > "$tmp/hooks/commit-msg"
  chmod +x "$tmp/hooks/commit-msg"
  echo two >> src/search/a.py
  git add -A
  fails agent_commit 'Change search'
  says 'DRIFT'
  new_repo plain
  git config core.hooksPath "$tmp/hooks"
  succeeds git commit -q --allow-empty -m 'No kit here'
}

test_over_max_lines_blocks_an_agent_warns_a_human() {
  echo 'More intent.' >> sdd/modules/search.md
  seq 1 211 > src/search/big.py
  git add -A
  fails bash sdd/bin/sdd audit
  says 'SIZE 211 changed lines of code and tests, over 200 by more than 5%.'
  succeeds git commit -qm 'Add a big search'
  says 'Warnings only'
}

test_up_to_five_percent_over_only_notes() {
  echo 'More intent.' >> sdd/modules/search.md
  seq 1 210 > src/search/big.py
  git add -A
  succeeds bash sdd/bin/sdd audit
  says 'NOTE 210 changed lines of code and tests, over 200 but within 5%.'
}

test_markdown_git_files_and_lockfiles_do_not_count() {
  echo 'More intent.' >> sdd/modules/search.md
  echo two >> src/search/a.py
  seq 1 300 > notes.md
  seq 1 300 > poetry.lock
  seq 1 300 > .gitignore
  git add -A
  succeeds bash sdd/bin/sdd audit
}

test_two_modules_block_an_agent() {
  echo 'More intent.' >> sdd/modules/search.md
  echo 'More intent.' >> sdd/modules/import.md
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  fails bash sdd/bin/sdd audit
  says 'SIZE the batch changes code of 2 modules.'
}

test_large_batch_lifts_both_limits() {
  echo 'More intent.' >> sdd/modules/search.md
  echo 'More intent.' >> sdd/modules/import.md
  seq 1 211 > src/search/big.py
  echo two >> src/import/a.py
  git add -A
  printf 'Big\n\nAgent-Assisted: yes\nLarge-Batch: one rename across both modules\n' > "$msg"
  succeeds bash sdd/bin/sdd audit --message "$msg"
  says 'NOTE 212 changed lines of code and tests, over 200: Large-Batch lifts it.'
  says 'NOTE the batch changes code of 2 modules: Large-Batch lifts it.'
}

test_touched_lists_each_module_with_its_lines() {
  printf 'two\nthree\n' >> src/search/a.py
  echo '# search' >> sdd/modules/search.md
  echo two >> src/import/a.py
  echo doc > README.md
  git add -A
  git commit -qm 'Change both' 2> /dev/null
  [ "$(bash sdd/bin/sdd touched)" = "$(printf 'import\t1\nsearch\t3')" ]
}

# Commits a line in module $1's code as author $2.
commit_as() {
  echo "$2" >> "src/$1/a.py"
  git add -A
  GIT_AUTHOR_NAME=$2 GIT_AUTHOR_EMAIL=$(tr 'A-Z ' 'a-z.' <<< "$2")@example.test git commit -qm "Change $1" 2> /dev/null
}

test_brief_spots_a_dev_s_first_batch_in_a_module() {
  git commit -q --amend --no-edit --no-verify --author='Ann Lee <ann.lee@example.test>'
  commit_as search 'Bob Roy'
  commit_as search 'Bob Roy'
  commit_as search Carl
  commit_as search Carl
  commit_as search Carl
  commit_as search Dan
  commit_as import Dev
  succeeds bash sdd/bin/sdd brief search
  [ "$(cat "$out")" = 'First batch of yours in search.
Who delivered there most: Carl, Bob Roy, Ann Lee.' ]
}

test_brief_is_silent_in_a_known_module() {
  git commit -q --amend --no-edit --no-verify --author='Ann Lee <ann.lee@example.test>'
  commit_as search Carl
  # The dev's own commit, under another case of the same address.
  echo dev >> src/search/a.py
  git add -A
  GIT_AUTHOR_EMAIL=DEV@example.test git commit -qm 'Change search' 2> /dev/null
  succeeds bash sdd/bin/sdd brief search
  [ ! -s "$out" ]
  # A mailmap that moves the dev to a new address maps their own identity too.
  echo 'Dev <dev@new.test> <dev@example.test>' > .mailmap
  succeeds bash sdd/bin/sdd brief search
  [ ! -s "$out" ]
  succeeds bash sdd/bin/sdd brief nothing
  [ ! -s "$out" ]
}

test_brief_shows_quizzes_waiting_in_other_worktrees() {
  git worktree add -q "$tmp/other" -b other
  git worktree add -q "$tmp/third" -b third
  succeeds bash sdd/bin/sdd brief
  [ ! -s "$out" ]
  # The dev's own quiz, in the worktree they run brief from, does not wait.
  touch "$tmp/other/QUIZ.md" QUIZ.md
  succeeds bash sdd/bin/sdd brief
  [ "$(wc -l < "$out")" -eq 1 ] && says 'A quiz waits for your answers in ' && says '/other.'
}

# Pushes branch $1 with a commit by $2, committed $3 hours ago.
push_branch() {
  git checkout -q -b "$1" main
  GIT_COMMITTER_DATE="$(($(date +%s) - $3 * 3600 - 60)) +0000" commit_as search "$2"
  git push -q origin "$1"
  git checkout -q main
}

# A remote with origin/HEAD on main, which holds a commit by Bob Roy pushed again as branch done. It is 72 hours old,
# so that only its merge keeps it out of brief.
remote() {
  git init -q --bare "$tmp/origin.git"
  git remote add origin "$tmp/origin.git"
  GIT_COMMITTER_DATE="$(($(date +%s) - 72 * 3600)) +0000" commit_as search 'Bob Roy'
  git push -q origin main main:done
}

test_brief_shows_branches_waiting_for_review_with_their_author() {
  remote
  # Names in the reverse order of their age, so that only the dates sort them.
  push_branch fresh Carl 3
  push_branch late Carl 4
  push_branch mine Dev 10
  push_branch stale 'Bob Roy' 72
  succeeds bash sdd/bin/sdd brief
  [ ! -s "$out" ]
  git remote set-head origin main
  succeeds bash sdd/bin/sdd brief
  [ "$(cat "$out")" = 'origin/stale waits for a review for 3 days, see Bob Roy.
origin/late waits for a review for 4 hours, see Carl.' ]
}

test_brief_says_three_lines_at_most() {
  git commit -q --amend --no-edit --no-verify --author='Ann Lee <ann.lee@example.test>'
  remote
  git remote set-head origin main
  push_branch late Carl 5
  push_branch stale 'Bob Roy' 72
  git worktree add -q "$tmp/other" -b other
  git worktree add -q "$tmp/third" -b third
  touch "$tmp/other/QUIZ.md" "$tmp/third/QUIZ.md"
  succeeds bash sdd/bin/sdd brief search
  [ "$(sed -n 3p "$out")" = 'origin/stale waits for a review for 3 days, see Bob Roy.' ]
  lacks 'origin/late'
  # The dev's first batch in search comes after what waits.
  [ "$(sed -n 4p "$out")" = 'First batch of yours in search.' ]
}

test_quiet_hides_a_green_output_and_shows_the_end_of_a_red_one() {
  succeeds bash sdd/bin/sdd quiet seq 100
  [ "$(cat "$out")" = 'ok: seq 100 (100 lines hidden)' ]
  fails bash sdd/bin/sdd quiet sh -c 'seq 100; exit 3'
  [ "$(head -n 1 "$out")" = 71 ] && [ "$(tail -n 1 "$out")" = "FAIL (3): sh -c seq 100; exit 3" ]
}

test_audit_notes_the_markdown_ratio() {
  succeeds bash sdd/bin/sdd audit
  says 'NOTE 8 lines of markdown for 2 lines of governed code, ratio 4.00 (guideline: at most 1).'
}

test_audit_points_out_governs_paths_that_match_nothing() {
  contract search src/serch/
  git add -A
  succeeds bash sdd/bin/sdd audit
  says 'NOTE sdd/modules/search.md: src/serch/ matches no tracked file, a typo or code still to come.'
}

# YAML's other ways to write a list: one path, or "- path" lines, flush or indented. The next key is no path.
test_governs_reads_a_scalar_or_a_block_list() {
  printf -- '---\ngoverns: src/search/\nrisk: high\n---\n# search\n' > sdd/modules/search.md
  printf -- '---\ngoverns:\n# owned here\n  - src/import/a.py  # the code\n- lib/\nrisk: high\n---\n# import\n' \
    > sdd/modules/import.md
  git add -A
  git commit -qm 'Write governs as YAML lists' 2> /dev/null
  echo two >> src/import/a.py
  git add -A
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/import.md: src/import/a.py changed'
  says 'NOTE sdd/modules/import.md: lib/ matches no tracked file'
  lacks 'risk: matches'
  lacks 'high matches'
  lacks 'here matches'
  lacks 'code matches'
}

test_a_governs_path_outside_the_repo_says_what_to_do() {
  contract search ../shared/
  git add -A
  fails git commit -qm 'Share search'
  says 'ERROR sdd/modules/search.md: governs ../shared/, outside the repo. Write each path from the repo root.'
  lacks 'fatal'
  contract search /shared/
  git add -A
  fails git commit -qm 'Share search'
  says 'ERROR sdd/modules/search.md: governs /shared/, outside the repo.'
}

test_before_the_first_commit_touched_says_so_and_the_hints_say_nothing() {
  new_repo empty
  mkdir sdd && cp -R "$kit/template/sdd/bin" sdd/
  fails bash sdd/bin/sdd touched
  says 'No commit HEAD here: commit first, or name a commit.'
  succeeds bash sdd/bin/cockpit hints
  [ ! -s "$out" ]
}

# The shell must not expand the glob: b.py is gone from the working tree, a.py is still there.
test_governs_takes_git_pathspecs() {
  contract search 'src/search/*.py'
  echo one > src/search/b.py
  git add -A
  git commit -qm 'Glob the paths' 2> /dev/null
  git rm -q src/search/b.py
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/search.md: src/search/b.py changed'
}

# A contract for search whose criterion links to $1.
linked_contract() {
  printf -- '---\ngoverns: [src/search/]\n---\n# search\n\n- Some behavior: %s\n' "$1" > sdd/modules/search.md
}

test_a_link_to_a_missing_file_is_drift() {
  linked_contract '[test_x](/tests/test_missing.py).'
  git add -A
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/search.md: links "test_x" to /tests/test_missing.py, a file the commit does not have.'
}

test_a_link_to_a_missing_test_name_is_drift() {
  mkdir -p tests
  echo 'def test_x_twice():' > tests/test_search.py
  linked_contract '[test_x](/tests/test_search.py), [a missing
  name](/tests/test_search.py).'
  git add -A
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/search.md: links "test_x", not found in tests/test_search.py.'
  says 'DRIFT sdd/modules/search.md: links "a missing name", not found in tests/test_search.py.'
  succeeds git commit -qm 'Link the tests'
  says 'Warnings only'
}

test_audit_accepts_links_to_names_groups_and_files() {
  mkdir -p tests
  printf 'class TestTagSearch:\n    def test_typo(self):\n        """corrects a misspelled term"""\n' \
    > tests/test_search.py
  linked_contract '[corrects a misspelled
  term](../../tests/test_search.py), [TestTagSearch](/tests/test_search.py#top),
  [test_search.py](/tests/test_search.py),
  [tests/test_search.py](../../tests/test_search.py), [the docs](https://example.com/docs), [workflow](../WORKFLOW.md),
  [the search code](/src/search/), [the tests](/tests).'
  # Written on Windows: CRLF must not split the wrapped link.
  awk '{ printf "%s\r\n", $0 }' sdd/modules/search.md > crlf.md && mv crlf.md sdd/modules/search.md
  git add -A
  succeeds bash sdd/bin/sdd audit
  lacks 'DRIFT'
}

test_markdown_ratio_leaves_out_the_kit_docs() {
  seq 1 50 > sdd/WORKFLOW.md
  mkdir sdd/guide
  seq 1 50 > sdd/guide/start.md
  git add -A
  succeeds bash sdd/bin/sdd audit
  says 'NOTE 8 lines of markdown'
}

test_range_checks_each_commit() {
  start=$(git rev-parse HEAD)
  echo two >> src/search/a.py
  git add -A
  git commit -q --no-verify -m 'Change search' -m 'Agent-Assisted: yes'
  echo 'Later intent.' >> sdd/modules/search.md
  git add -A
  git commit -q --no-verify -m 'Touch the contract later' -m 'Agent-Assisted: yes'
  fails bash sdd/bin/sdd audit --range "$start..HEAD"
  says 'DRIFT sdd/modules/search.md'
  says 'FAIL'
  # An agent batch with no quiz passes: CI never asks for one.
  says 'OK   '
  echo three >> src/search/a.py
  git add -A
  git commit -q --no-verify -m 'Change search again'
  # An unknown base audits the tip only: the human's drift warns.
  succeeds bash sdd/bin/sdd audit --range "1234567890123456789012345678901234567890..HEAD"
  says 'Warnings only'
}

test_range_ignores_commits_before_adoption() {
  new_repo new
  echo start > README.md
  git add -A
  git commit -qm 'Start'
  start=$(git rev-parse HEAD)
  mkdir -p src
  seq 1 500 > src/big.py
  git add -A
  git commit -qm 'Before adoption' -m 'Agent-Assisted: yes'
  mkdir -p sdd/bin sdd/modules
  cp -R "$kit/template/sdd/bin/." sdd/bin/
  printf -- '---\ngoverns: [src/]\n---\n# app\n' > sdd/modules/app.md
  git add -A
  git commit -qm 'Adopt'
  succeeds bash sdd/bin/sdd audit --range "$start..HEAD"
}

# A ready agent batch on search: code and contract.
batch() {
  echo two >> src/search/a.py
  echo 'More intent.' >> sdd/modules/search.md
  git add -A
}

# The reviewer's side: QUIZ.md citing file $1, and the key with answers $2 (like "A B C"), one question each.
write_quiz() {
  local key a i=0
  key=$(bash sdd/bin/sdd fingerprint | sed -n 's/^key: //p')
  {
    bash sdd/bin/sdd fingerprint | sed -n 's/^fingerprint: //p'
    for a in $2; do echo "$a Because of $a."; done
  } > "$key"
  {
    echo '# Quiz for this batch'
    for a in $2; do
      i=$((i + 1))
      printf '\n## %s. Question %s?\n\nSee %s:2\n\n- [ ] one\n- [ ] two\n- [ ] three\n' "$i" "$i" "$1"
    done
  } > QUIZ.md
}

# The human's side: tick box $2 (A, B or C) of question $1, and clear its other boxes.
tick() {
  awk -v q="$1" -v pick="$2" '
    /^## / { n++; box = 0 }
    n == q && /^- \[[ x]\]/ { box++; sub(/\[[ x]\]/, substr("ABCD", box, 1) == pick ? "[x]" : "[ ]") }
    { print }' QUIZ.md > QUIZ.tmp
  mv QUIZ.tmp QUIZ.md
}

# Sets the See line of question $1 to $2.
see() {
  awk -v q="$1" -v see="See $2" '/^## / { n++ } n == q && /^See / { $0 = see } 1' QUIZ.md > QUIZ.tmp
  mv QUIZ.tmp QUIZ.md
}

answer() {
  local i=0 a
  for a in "$@"; do
    i=$((i + 1))
    tick "$i" "$a"
  done
}

test_bypass_quiz_with_a_reason_skips_the_quiz() {
  batch
  succeeds git commit -q -m 'Change search' -m 'Agent-Assisted: yes' -m 'Bypass-Quiz: redone after a passed quiz'
  git log -1 --format=%B | grep -qx 'Bypass-Quiz: redone after a passed quiz'
  if git log -1 --format=%B | grep -q '^Quiz:'; then echo '    a bypassed quiz has no Quiz trailer'; return 1; fi
}

test_bypass_quiz_holds_at_high_risk() {
  printf -- '---\ngoverns: [src/search/]\nrisk: high\n---\n# search\n' > sdd/modules/search.md
  git add -A
  git commit -qm 'Search is risky'
  batch
  succeeds git commit -q -m 'Change search' -m 'Agent-Assisted: yes' -m 'Bypass-Quiz: hotfix, reviewed by two'
}

test_bypass_quiz_still_checks_drift() {
  echo two >> src/search/a.py
  git add -A
  fails git commit -q -m 'Change search' -m 'Agent-Assisted: yes' -m 'Bypass-Quiz: urgent'
  says 'DRIFT sdd/modules/search.md'
}

test_bypass_quiz_still_checks_size() {
  echo 'More intent.' >> sdd/modules/search.md
  seq 1 300 > src/search/big.py
  git add -A
  fails git commit -q -m 'Add a big search' -m 'Agent-Assisted: yes' -m 'Bypass-Quiz: urgent'
  says 'SIZE 300 changed lines of code and tests'
}

test_bypass_quiz_without_a_reason_asks_the_quiz() {
  batch
  fails git commit -q -m 'Change search' -m 'Agent-Assisted: yes' -m 'Bypass-Quiz:'
  says 'Bypass-Quiz needs a reason after the colon'
  says 'No quiz for this agent-assisted batch'
}

# The message the agent proposes at step 5, one line per argument.
propose() {
  mkdir -p "$(dirname "$(git rev-parse --git-path sdd/message)")"
  printf '%s\n' "$@" > "$(git rev-parse --git-path sdd/message)"
}

test_next_leads_a_batch_to_its_quiz() {
  succeeds bash sdd/bin/sdd next
  [ "$(cat "$out")" = 'Nothing to propose: no tracked file changed.' ]
  touch notes.txt
  echo two >> src/search/a.py
  succeeds bash sdd/bin/sdd next
  says 'step 5: stage the batch, these files changed and are not staged: src/search/a.py.'
  says 'Untracked, stage those of the batch: notes.txt.'
  git add src/search/a.py
  succeeds bash sdd/bin/sdd next
  says 'step 5: write the proposed message, with Agent-Assisted: yes, to .git/sdd/message.'
  propose 'Change search' '' 'Agent-Assisted: yes'
  succeeds bash sdd/bin/sdd next
  says 'step 3: fix what the audit finds.'
  says 'DRIFT sdd/modules/search.md'
  echo 'More intent.' >> sdd/modules/search.md
  git add -A
  succeeds bash sdd/bin/sdd next
  says 'step 6: a fresh reviewer'
  write_quiz README.md 'A B C'
  succeeds bash sdd/bin/sdd next
  says 'step 6: the reviewer fixes its quiz. Question 1 needs a See line'
  write_quiz src/search/a.py 'A B C'
  succeeds bash sdd/bin/sdd next
  says 'step 7: hand off, then the human answers QUIZ.md and commits with git commit -F .git/sdd/message.'
  echo three >> src/search/a.py
  git add -A
  succeeds bash sdd/bin/sdd next
  says 'step 6: the batch changed since the quiz'
}

test_next_sends_size_to_step_5_and_skips_a_quiz_not_asked() {
  echo 'More intent.' >> sdd/modules/search.md
  seq 1 300 > src/search/a.py
  git add -A
  propose 'Change search' '' 'Agent-Assisted: yes'
  succeeds bash sdd/bin/sdd next
  says 'step 5: fix what the audit finds.'
  says 'SIZE 301 changed lines of code and tests'
  propose 'Change search' '' 'Agent-Assisted: yes' 'Large-Batch: generated' 'Bypass-Quiz: redone after a passed quiz'
  succeeds bash sdd/bin/sdd next
  says 'step 7: hand off, then the human commits with'
  git commit -q -F .git/sdd/message 2> /dev/null
  echo 'Notes.' > NOTES.md
  git add -A
  # The message of the last commit, left behind.
  touch -t 200001010000 .git/sdd/message
  succeeds bash sdd/bin/sdd next
  says 'step 5: write the proposed message'
  propose 'Add notes' '' 'Agent-Assisted: yes'
  succeeds bash sdd/bin/sdd next
  says 'step 7: hand off, then the human commits with'
}

test_quiz_passed_adds_the_trailer_and_cleans_up() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  succeeds agent_commit 'Change search'
  lacks 'The batch changed'
  git log -1 --format=%B | grep -qx 'Quiz: 3/3, covers 1/1'
  [ ! -e QUIZ.md ]
  [ ! -e "$(git rev-parse --git-path sdd/quiz-key)" ]
}

# Hunks of code: a change, a deletion met at the line before it, a change, and a new file. Markdown counts for none.
test_the_trailer_says_how_much_the_quiz_covers() {
  seq 1 9 > src/search/a.py
  git add -A
  git commit -qm 'Nine lines' 2> /dev/null
  git config diff.noprefix true
  git config color.diff always
  git config diff.interHunkContext 3
  sed -e 's/^2$/two/' -e '/^5$/d' -e 's/^8$/eight/' src/search/a.py > a.tmp && mv a.tmp src/search/a.py
  echo new > src/search/b.py
  echo 'More intent.' >> sdd/modules/search.md
  git add -A
  write_quiz src/search/a.py 'A B C'
  see 1 src/search/a.py:1
  see 3 src/search/a.py:4
  answer A B C
  succeeds agent_commit 'Change search'
  git log -1 --format=%B | grep -qx 'Quiz: 3/3, covers 2/4'
  echo 'How to run it.' > README.md
  git add -A
  write_quiz README.md 'A B C'
  answer A B C
  succeeds agent_commit 'Explain how to run it'
  git log -1 --format=%B | grep -qx 'Quiz: 3/3'
}

test_wrong_answer_explains_then_a_retry_passes() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A C C
  fails agent_commit 'Change search'
  says 'Question 2 is wrong: a hint is in QUIZ.md.'
  lacks 'Because of B.'
  says '2/3. Fix your answers in QUIZ.md'
  [ -e QUIZ.md ]
  answer A B C
  succeeds agent_commit 'Change search'
}

# The lines of question $1 in QUIZ.md, up to the next question.
question() { awk -v q="$1" '/^## / { n++ } n == q' QUIZ.md; }

test_a_wrong_answer_writes_a_hint_block_in_the_quiz() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A C C
  fails agent_commit 'Change search'
  question 2 | grep -qxF '> Wrong. Hint: Because of B.'
  question 2 | grep -qxF '> Type *quiz feedback* to your agent to talk it through.'
  question 2 | grep -qxF '> - [ ] The question is unclear'
  [ -z "$(question 1 | grep '^>')" ]
  [ "$(grep -c '^## ' QUIZ.md)" -eq 3 ]
  before=$(cat QUIZ.md)
  fails agent_commit 'Change search'
  [ "$(cat QUIZ.md)" = "$before" ]
}

# The block speaks the dev's language when the key gives its eight lines; the journal reads its boxes by place.
test_the_block_speaks_the_key_s_language() {
  batch
  write_quiz src/search/a.py 'A B C'
  printf '%s\n' 'Faux.' 'Indice :' 'Tape *quiz feedback* pour en parler avec ton agent.' \
    'Facultatif, pourquoi ? (reste sur cette machine)' "Je n'avais pas compris le code" 'La question est floue' \
    'Le code ne fait pas ce que je voulais' 'Autre :' >> "$(git rev-parse --git-path sdd/quiz-key)"
  answer A C C
  fails agent_commit 'Change search'
  question 2 | grep -qxF '> Faux. Indice : Because of B.'
  question 2 | grep -qxF '> - [ ] La question est floue'
  sed -e 's/^> - \[ \] La question est floue/> - [x] La question est floue/' \
    -e 's/^> - Autre :$/> - Autre : trop long/' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  answer A B C
  succeeds agent_commit 'Change search'
  [ "$(cut -f 4,6 "$(git rev-parse --git-common-dir)/sdd/quiz-journal")" = "unclear	trop long" ]
}

test_a_new_try_keeps_the_feedback_ticked() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A C C
  fails agent_commit 'Change search'
  sed -e 's/^> - \[ \] The question is unclear/> - [x] The question is unclear/' \
    -e 's/^> - Other:$/> - Other: too long/' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  fails agent_commit 'Change search'
  question 2 | grep -qxF '> - [x] The question is unclear'
  question 2 | grep -qxF '> - [ ] I had not understood the code'
  question 2 | grep -qxF '> - Other: too long'
}

test_feedback_never_changes_the_grade() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A C C
  fails agent_commit 'Change search'
  sed 's/^> - \[ \] The code does not do/> - [x] The code does not do/' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  fails agent_commit 'Change search'
  says 'Question 2 is wrong'
  answer A B C
  succeeds agent_commit 'Change search'
  git log -1 --format=%B | grep -qx 'Quiz: 3/3, covers 1/1'
}

journal() { cat "$(git rev-parse --git-common-dir)/sdd/quiz-journal"; }

# Fails questions 2 and 3, ticks "unclear" under 2 and writes words with a tab under 3, fails again, then passes.
flag_and_pass() {
  answer A C B
  fails agent_commit 'Change search'
  awk '/^## / { n++ }
    n == 2 { sub(/^> - \[ \] The question is unclear/, "> - [x] The question is unclear") }
    n == 3 { sub(/^> - Other:$/, "> - Other: too\tlong") }
    { print }' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  fails agent_commit 'Change search'
  [ ! -s "$(git rev-parse --git-common-dir)/sdd/quiz-journal" ]
  answer A B C
  succeeds agent_commit 'Change search'
}

test_a_passed_quiz_journals_its_flagged_questions() {
  batch
  write_quiz src/search/a.py 'A B C'
  flag_and_pass
  [ "$(journal | awk -F '\t' '$1 == "v2" && $2 ~ /^[0-9]+$/ { print $3 "|" $4 "|" $5 "|" $6 }')" = \
    'search|unclear|Question 2?|-
search|-|Question 3?|too long' ]
}

test_worktrees_share_the_quiz_journal() {
  git worktree add -q "$tmp/other" -b other
  cd "$tmp/other"
  batch
  write_quiz src/search/a.py 'A B C'
  flag_and_pass
  [ "$(grep -c '^v2' "$tmp/repo/.git/sdd/quiz-journal")" -eq 2 ]
}

test_a_high_risk_quiz_covers_every_hunk() {
  printf -- '---\ngoverns: [src/search/]\nrisk: high\n---\n# search\n' > sdd/modules/search.md
  git add -A
  git commit -qm 'Search is at high risk'
  batch
  echo new > src/search/b.py
  git add -A
  write_quiz src/search/a.py 'A B'
  fails bash sdd/bin/sdd audit
  says 'NOTE search: high risk, the quiz cites every hunk of code and a second human'
  says 'QUIZ.md needs 3 questions or more'
  write_quiz src/search/a.py 'A B C A'
  fails bash sdd/bin/sdd audit
  says 'QUIZ.md cites 1 of 2 hunks of code; at high risk, its See lines cite them all. Missed: src/search/b.py:1.'
  see 1 'src/search/a.py:2, src/search/b.py:1'
  succeeds bash sdd/bin/sdd audit
  answer A B C A
  succeeds agent_commit 'Change search'
  git log -1 --format=%B | grep -qx 'Quiz: 4/4, covers 2/2'
  # The batch that drops risk: high is still judged at high risk, and the hook never checks what the quiz covers.
  printf -- '---\ngoverns: [src/search/]\n---\n# search\n' > sdd/modules/search.md
  echo three >> src/search/b.py
  git add -A
  write_quiz sdd/modules/search.md 'A B C'
  fails bash sdd/bin/sdd audit
  says 'NOTE search: high risk'
  answer A B C
  succeeds agent_commit 'Lower the risk of search'
  git log -1 --format=%B | grep -qx 'Quiz: 3/3, covers 0/1'
}

test_the_config_sets_the_risk_a_contract_overrides() {
  printf '# Every module handles money.\nrisk: "high"  # until the audit\n' > sdd/config.yml
  git add -A
  git commit -qm 'Put the repo at high risk'
  batch
  echo two >> src/import/a.py
  git add -A
  printf 'Change both\n\nAgent-Assisted: yes\nSpec-Unchanged(import): renames only\nLarge-Batch: one rename\n' > "$msg"
  succeeds bash sdd/bin/sdd audit --message "$msg"
  says 'NOTE import, search: high risk'
  printf -- '---\ngoverns: [src/search/]\nrisk: normal\n---\n# search\n' > sdd/modules/search.md
  git add -A
  git commit -q --no-verify -m 'Keep search at normal risk'
  echo three >> src/search/a.py
  echo three >> src/import/a.py
  echo 'More.' >> sdd/modules/search.md
  git add -A
  succeeds bash sdd/bin/sdd audit --message "$msg"
  says 'NOTE import: high risk'
}

test_a_markdown_only_batch_needs_no_quiz() {
  echo 'How to run it.' > README.md
  git add -A
  succeeds agent_commit 'Explain how to run it'
  [ -z "$(git log -1 --format=%B | grep '^Quiz:')" ]
  echo 'More.' >> README.md
  git add -A
  write_quiz README.md 'A B C'
  answer A B B
  fails agent_commit 'Explain more'
  says 'Question 3 is wrong'
  rm QUIZ.md
  echo 'More intent.' >> sdd/modules/search.md
  git add -A
  fails agent_commit 'Explain more'
  says 'No quiz for this agent-assisted batch'
}

# As in the field: the first batch of a new project writes its documents and a .gitignore.
test_markdown_and_git_files_need_no_quiz() {
  echo 'What it is.' > README.md
  printf '__pycache__/\n' > .gitignore
  printf '* text=auto\n' > .gitattributes
  printf '* text=auto\n' > docs.gitattributes
  mkdir -p docs/drafts && touch docs/drafts/.gitkeep
  git add -A
  fails agent_commit 'Write the documents'
  says 'No quiz for this agent-assisted batch'
  git rm -q --cached docs.gitattributes
  succeeds agent_commit 'Write the documents'
  [ -z "$(git log -1 --format=%B | grep '^Quiz:')" ]
}

test_a_governed_markdown_batch_asks_a_quiz() {
  echo 'How search ranks.' > src/search/notes.md
  git add -A
  fails git commit -q -m 'Explain ranking' -m 'Agent-Assisted: yes' -m 'Spec-Unchanged(search): notes only'
  says 'No quiz for this agent-assisted batch'
}

test_a_deleted_high_risk_contract_is_high_risk() {
  printf -- '---\ngoverns: [src/search/]\nrisk: high\n---\n# search\n' > sdd/modules/search.md
  git add -A
  git commit -qm 'Search is at high risk'
  git rm -q sdd/modules/search.md
  bash sdd/bin/sdd audit > "$out" 2>&1 || true
  says 'NOTE search: high risk'
}

test_a_worktree_hook_reads_relative_links() {
  mkdir tests
  echo 'def test_x(): pass' > tests/test_search.py
  printf -- '---\ngoverns: [src/search/]\n---\n# search\n\n- X: [test_x](../../tests/test_search.py).\n' \
    > sdd/modules/search.md
  git add -A
  git commit -qm 'Link a test'
  git worktree add -q "$tmp/other" -b other
  cd "$tmp/other"
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  succeeds agent_commit 'Change search'
}

# Its commit was checked when first made; finishing it after a conflict asks for no new quiz.
test_a_cherry_pick_asks_no_new_quiz() {
  git checkout -q -b side
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  agent_commit 'Change search'
  git checkout -q main
  echo clash >> src/search/a.py
  git commit -qam 'Clash' 2> /dev/null
  git cherry-pick side > /dev/null 2>&1 || true
  printf 'one\ntwo\n' > src/search/a.py
  git add -A
  GIT_EDITOR=true succeeds git cherry-pick --continue
}

# The quiz goes once its commit exists: a later commit-msg hook that fails keeps it.
test_a_failing_later_hook_keeps_the_quiz() {
  hook=$(git rev-parse --git-path hooks)/commit-msg
  echo 'exit 1' >> "$hook"
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  fails agent_commit 'Change search'
  [ -f QUIZ.md ] && [ -f "$(git rev-parse --git-path sdd/quiz-key)" ]
  sed '$d' "$hook" > "$tmp/hook" && cat "$tmp/hook" > "$hook"
  succeeds agent_commit 'Change search'
  [ ! -e QUIZ.md ]
}

# A batch committed without the hook leaves no quiz for the next one, and journals nothing.
test_a_commit_without_the_hook_leaves_no_quiz() {
  batch
  write_quiz src/search/a.py 'A B C'
  tick 1 A
  echo '> - [x] The question is unclear' >> QUIZ.md
  git commit -q --no-verify -m 'Change search'
  [ ! -e QUIZ.md ]
  [ ! -e "$(git rev-parse --git-common-dir)/sdd/quiz-journal" ]
  echo three >> src/search/a.py
  echo 'More.' >> sdd/modules/search.md
  git add -A
  fails agent_commit 'Change search again'
  says 'No quiz for this agent-assisted batch'
}

test_an_amend_clears_its_quiz() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  agent_commit 'Change search'
  echo three >> src/search/a.py
  echo 'More.' >> sdd/modules/search.md
  git add -A
  write_quiz src/search/a.py 'A B C'
  answer A B C
  succeeds git commit -q --amend -m 'Change search' -m 'Agent-Assisted: yes'
  [ ! -e QUIZ.md ]
}

# A clone whose hooks predate the post-commit line: the reviewer's next fingerprint clears the quiz.
test_the_next_fingerprint_clears_a_quiz_left_behind() {
  rm "$(git rev-parse --git-path hooks)/post-commit"
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  agent_commit 'Change search'
  [ -f QUIZ.md ]
  bash sdd/bin/sdd fingerprint > /dev/null
  [ ! -e QUIZ.md ]
}

test_audit_clears_the_last_commit_s_quiz() {
  rm "$(git rev-parse --git-path hooks)/post-commit"
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  agent_commit 'Change search'
  echo three >> src/search/a.py
  echo 'More.' >> sdd/modules/search.md
  git add -A
  succeeds bash sdd/bin/sdd audit
  [ ! -e QUIZ.md ]
}

test_a_quiz_older_than_the_batch_only_warns() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  echo three >> src/search/a.py
  git add -A
  succeeds agent_commit 'Change search'
  says 'NOTE The batch changed since the quiz was written'
}

test_an_incomplete_quiz_is_refused() {
  batch
  fails agent_commit 'Change search'
  says 'No quiz for this agent-assisted batch'
  write_quiz src/search/a.py 'A B C'
  fails agent_commit 'Change search'
  says 'Tick exactly one box for question 1'
  sed 's/\[ \]/[x]/' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  fails agent_commit 'Change search'
  says 'Tick exactly one box for question 1'
  write_quiz README.md 'A B C'
  answer A B C
  fails agent_commit 'Change search'
  says 'Question 1 needs a See line citing one to three places of this batch'
}

# The reviewer runs the audit once the quiz is written: what the hook would refuse shows up before the human sees it.
test_audit_checks_the_quiz_before_the_human() {
  batch
  write_quiz README.md 'A B C'
  fails bash sdd/bin/sdd audit
  says 'Question 1 needs a See line citing one to three places of this batch'
  write_quiz src/search/a.py 'A B D'
  fails bash sdd/bin/sdd audit
  says 'Question 3 has no right box in the key'
  write_quiz src/search/a.py 'B B B'
  succeeds bash sdd/bin/sdd audit
  says 'NOTE QUIZ.md: the right answer is box B every time, vary it.'
  rm "$(git rev-parse --git-path sdd/quiz-key)"
  fails bash sdd/bin/sdd audit
  says 'QUIZ.md has no key'
}

test_a_see_line_cites_three_places_at_most() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  sed '/^See /s/$/, sdd\/modules\/search.md:2-3, src\/search\/a.py:1, src\/search\/a.py:3/' QUIZ.md > QUIZ.tmp
  mv QUIZ.tmp QUIZ.md
  fails agent_commit 'Change search'
  says 'Question 1 needs a See line citing one to three places of this batch'
  sed 's/, src\/search\/a.py:3$//' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  succeeds agent_commit 'Change search'
}

test_quiz_files_with_crlf() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  key=$(git rev-parse --git-path sdd/quiz-key)
  awk '{ printf "%s\r\n", $0 }' QUIZ.md > QUIZ.tmp && mv QUIZ.tmp QUIZ.md
  awk '{ printf "%s\r\n", $0 }' "$key" > key.tmp && mv key.tmp "$key"
  succeeds agent_commit 'Change search'
}

test_quiz_trailer_with_editor_comments() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  printf 'Change search\n\nAgent-Assisted: yes\n' > "$msg"
  GIT_EDITOR=true succeeds git commit -q -e -F "$msg"
  git log -1 --format=%B | grep -qx 'Quiz: 3/3, covers 1/1'
  git log -1 --format=%B | grep -qx 'Agent-Assisted: yes'
}

test_script_survives_a_crlf_checkout() {
  cp "$kit/template/.gitattributes" .gitattributes
  git add -A
  git commit -qm 'Pin line ends' 2> /dev/null
  git config core.autocrlf true
  rm sdd/bin/sdd
  git checkout -- sdd/bin/sdd
  echo 'More intent.' >> sdd/modules/search.md
  echo two >> src/search/a.py
  git add -A 2> /dev/null
  succeeds git commit -qm 'Change search'
}

test_non_ascii_file_names() {
  echo one > src/search/café.py
  git add -A
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/search.md: src/search/café.py changed'
}

test_rewording_an_agent_commit() {
  batch
  write_quiz src/search/a.py 'A B C'
  answer A B C
  agent_commit 'Change search'
  succeeds git commit -q --amend -m 'Change search, reworded' -m 'Agent-Assisted: yes'
}

test_quoted_governs_paths() {
  printf -- '---\ngoverns: ["src/search/", '"'"'src/import'"'"']\n---\n# search\n' > sdd/modules/search.md
  git add -A
  git commit -qm 'Quote the paths' 2> /dev/null
  echo two >> src/import/a.py
  git add -A
  fails bash sdd/bin/sdd audit
  says 'DRIFT sdd/modules/search.md: src/import/a.py changed'
}

test_an_agent_co_author_marks_an_agent_batch() {
  echo two >> src/search/a.py
  git add -A
  fails git commit -qm 'Change search' -m 'Co-Authored-By: Claude <noreply@anthropic.com>'
  says 'Refused, agent-assisted batch'
}

test_a_human_co_author_named_claude_is_human() {
  echo two >> src/search/a.py
  git add -A
  succeeds git commit -qm 'Change search' -m 'Co-Authored-By: Claude Dupont <claude.dupont@example.fr>'
}

names=${*:-$(declare -F | awk '$3 ~ /^test_/ { print $3 }')}
failed=0
for t in $names; do
  ( set -e; setup; "$t" )
  # Quiet when green: the agent that runs the tests reads every line.
  if [ $? -ne 0 ]; then echo "FAIL $t"; failed=$((failed + 1)); fi
done
echo "$failed failed of $(wc -w <<< "$names" | tr -d ' ')"
[ "$failed" -eq 0 ]
