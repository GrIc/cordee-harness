#!/usr/bin/env bash
# Runs template/cordee/bin/cordee against throwaway git repos. Usage: bash test/run [test_name...]
set -u

kit=$(cd "$(dirname "$0")/.." && pwd)
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Dev GIT_AUTHOR_EMAIL=dev@example.test GIT_COMMITTER_NAME=Dev GIT_COMMITTER_EMAIL=dev@example.test

contract() { printf -- '---\ngoverns: [%s]\n---\n# %s\n' "$2" "$1" > "cordee/modules/$1.md"; }

# An empty repo in $tmp/$1, the working directory from then on.
new_repo() { mkdir "$tmp/$1" && cd "$tmp/$1" && git -c init.defaultBranch=main init -q; }

# A repo with the harness and two contracts, search and import, each governing its src/ folder.
setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  new_repo repo
  git config core.autocrlf false
  mkdir -p cordee/bin cordee/modules src/search src/import
  cp -R "$kit/template/cordee/bin/." cordee/bin/
  contract search src/search/
  contract import src/import
  echo one > src/search/a.py
  echo one > src/import/a.py
  git add -A
  git commit -qm 'Adopt Cordee'
  bash cordee/bin/cordee install-hook > /dev/null
  msg=$tmp/msg
  out=$tmp/out
}

succeeds() { "$@" > "$out" 2>&1 || { echo "    expected success: $*"; sed 's/^/    | /' "$out"; return 1; }; }
fails() { if "$@" > "$out" 2>&1; then echo "    expected failure: $*"; sed 's/^/    | /' "$out"; return 1; fi; }
says() { grep -qF -- "$1" "$out" || { echo "    output lacks: $1"; sed 's/^/    | /' "$out"; return 1; }; }
lacks() { if grep -qF -- "$1" "$out"; then echo "    output has: $1"; sed 's/^/    | /' "$out"; return 1; fi; }
agent_commit() { git commit -q -m "$1" -m 'Agent-Assisted: yes'; }

test_agent_drift_blocks() {
  echo two >> src/search/a.py
  git add -A
  fails agent_commit 'Change search'
  says 'DRIFT cordee/modules/search.md: src/search/a.py changed, its contract did not.'
}

test_human_drift_warns_and_commits() {
  echo two >> src/search/a.py
  git add -A
  succeeds git commit -qm 'Change search'
  says 'DRIFT cordee/modules/search.md'
  [ "$(git log -1 --format=%s)" = 'Change search' ]
}

test_spec_unchanged_spares_its_module_only() {
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  printf 'Rename\n\nAgent-Assisted: yes\nSpec-Unchanged(search): renames only\n' > "$msg"
  fails bash cordee/bin/cordee audit --message "$msg"
  says 'DRIFT cordee/modules/import.md'
  lacks 'DRIFT cordee/modules/search.md'
}

test_a_spared_module_does_not_count_toward_the_module_limit() {
  echo 'More intent.' >> cordee/modules/search.md
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  printf 'Change search\n\nAgent-Assisted: yes\nSpec-Unchanged(import): renames only\n' > "$msg"
  succeeds bash cordee/bin/cordee audit --message "$msg"
}

test_errors_stop_even_a_human_commit() {
  echo two >> src/search/a.py
  git add -A
  fails git commit -qm 'Change search' -m 'Spec-Unchanged(serch): typo'
  says 'ERROR Spec-Unchanged(serch): no such module. Modules: import, search.'
  contract import ''
  git add -A
  fails git commit -qm 'Change search'
  says 'ERROR cordee/modules/import.md: governs is empty.'
}

test_spec_unchanged_names_one_module_with_a_reason() {
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  printf 'Rename\n\nAgent-Assisted: yes\nSpec-Unchanged(search import): renames only\n' > "$msg"
  fails bash cordee/bin/cordee audit --message "$msg"
  says 'ERROR Spec-Unchanged(search import): name one module'
  printf 'Rename\n\nAgent-Assisted: yes\nSpec-Unchanged(search):\nSpec-Unchanged(import): renames only\n' > "$msg"
  fails bash cordee/bin/cordee audit --message "$msg"
  says 'ERROR Spec-Unchanged(search): no reason'
}

test_multiline_governs_is_read_fully() {
  printf -- '---\ngoverns:\n  [\n    src/search/a.py,\n    lib/search/,\n  ]\ndepends: [import]\n---\n# search\n' \
    > cordee/modules/search.md
  git add -A
  git commit -qm 'Reshape the contract'
  mkdir -p lib/search
  echo one > lib/search/b.py
  git add -A
  fails bash cordee/bin/cordee audit
  says 'DRIFT cordee/modules/search.md: lib/search/b.py changed'
}

test_merge_is_not_checked() {
  git checkout -qb side
  echo two >> src/import/a.py
  git add -A
  git commit -qm 'Side' 2> /dev/null
  git checkout -q main
  echo two >> src/search/a.py
  git add -A
  git commit -qm 'Main' 2> /dev/null
  succeeds git merge -q --no-ff side -m 'Merge side' -m 'Agent-Assisted: yes'
}

test_first_commit_of_a_repo() {
  new_repo new
  mkdir -p cordee/bin
  cp -R "$kit/template/cordee/bin/." cordee/bin/
  bash cordee/bin/cordee install-hook > /dev/null
  git add -A
  succeeds git commit -qm 'Start'
}

test_install_hook_respects_an_existing_hook() {
  hooks=$(git rev-parse --git-path hooks)
  printf '#!/bin/sh\nexit 0\n' > "$hooks/commit-msg"
  fails bash cordee/bin/cordee install-hook
  says 'bash cordee/bin/cordee hook "$1"'
  says "Installed $hooks/post-commit."
  lacks 'cordee.ledger'
  [ ! -e "$hooks/pre-push" ]
  grep -qx '/QUIZ.md' "$(git rev-parse --git-path info/exclude)"
}

test_install_hook_keeps_the_last_line_of_exclude() {
  exclude=$(git rev-parse --git-path info/exclude)
  printf '*.log' > "$exclude"
  succeeds bash cordee/bin/cordee install-hook
  [ "$(cat "$exclude")" = "$(printf '*.log\n/QUIZ.md')" ]
}

test_install_hook_adds_the_ledger_hooks_that_pass_without_it() {
  hooks=$(git rev-parse --git-path hooks)
  committed='[ ! -f cordee/bin/cordee ] || bash cordee/bin/cordee committed'
  grep -qxF "$committed" "$hooks/post-commit"
  [ ! -e "$hooks/pre-push" ]
  rm -rf cordee/bin/cockpit cordee/bin/ledger cordee/bin/harness/cockpit.py cordee/bin/harness/ledger.py \
    cordee/bin/harness/logs
  succeeds bash cordee/bin/cordee audit
  succeeds bash cordee/bin/cordee next
  succeeds bash cordee/bin/cordee doctor
  says 'tokens: off'
  echo 'tokens: true' > cordee/config.yml
  succeeds bash cordee/bin/cordee hints
  succeeds bash cordee/bin/cordee install-hook
  says 'git config cordee.ledger false stops it.'
  grep -qxF "$committed; [ ! -f cordee/bin/ledger ] || bash cordee/bin/ledger record" "$hooks/post-commit"
  grep -qxF '[ ! -f cordee/bin/ledger ] || bash cordee/bin/ledger sync "$1"' "$hooks/pre-push"
  git init -q --bare "$tmp/origin.git"
  succeeds git push -q "$tmp/origin.git" HEAD:main
  rm cordee/config.yml
  succeeds bash cordee/bin/cordee install-hook
  [ ! -e "$hooks/pre-push" ]
}

# A shared hook (core.hooksPath) runs in every repo: the line install-hook prints must block here and pass elsewhere.
test_the_line_for_a_shared_hook() {
  echo 'tokens: true' > cordee/config.yml
  git config core.hooksPath "$tmp/hooks"
  fails bash cordee/bin/cordee install-hook
  says "Your commit-msg hook is $(git rev-parse --git-path hooks)/commit-msg"
  line='[ ! -f cordee/bin/cordee ] || bash cordee/bin/cordee committed;'
  says "$line [ ! -f cordee/bin/ledger ] || bash cordee/bin/ledger record"
  says '[ ! -f cordee/bin/ledger ] || bash cordee/bin/ledger sync "$1"'
  rm cordee/config.yml
  mkdir "$tmp/hooks"
  { echo '#!/bin/sh'; sed -n '/commit-msg hook/{n;p;}' "$out"; echo 'echo other checks pass'; } \
    > "$tmp/hooks/commit-msg"
  chmod +x "$tmp/hooks/commit-msg"
  echo two >> src/search/a.py
  git add -A
  fails agent_commit 'Change search'
  says 'DRIFT'
  new_repo plain
  git config core.hooksPath "$tmp/hooks"
  succeeds git commit -q --allow-empty -m 'No kit here'
}

test_deploy_copies_what_is_missing_and_lists_the_rest() {
  new_repo app
  git remote add origin git@github.com:acme/gitlab-tools.git
  echo '# Ours' > AGENTS.md
  mkdir sub && cd sub
  succeeds bash "$kit/template/cordee/bin/cordee" deploy https://example.test/kit v9.9.9
  cd ..
  says 'with the CI file for github.'
  says '  AGENTS.md'
  lacks '  CLAUDE.md'
  [ "$(cat AGENTS.md)" = '# Ours' ]
  cmp -s CLAUDE.md "$kit/template/CLAUDE.md"
  [ -f .github/workflows/cordee.yml ] && [ ! -e .gitlab-ci.yml ]
  [ "$(head -1 cordee/README.md)" = 'Deployed from https://example.test/kit v9.9.9.' ]
  grep -qF 'cordee/bin/cordee hook' "$(git rev-parse --git-path hooks)/commit-msg"
  git add -A
  succeeds git commit -qm 'Deploy Cordee' -m 'Large-Batch: deploys Cordee'

  printf '# Ours\n\n<!-- sdd-fabrik -->\nold\n<!-- /sdd-fabrik -->\n\n# Footer\n' > AGENTS.md
  printf 'Deployed from https://example.test/kit v0.1.0.\n\n# Our map\n' > cordee/README.md
  echo old | tee cordee/WORKFLOW.md cordee/GETTING-STARTED.md > cordee/REFERENCE.md
  echo old > cordee/bin/sdd
  rm cordee/modules/.gitkeep
  echo 'batch-lines: 150' > cordee/config.yml
  succeeds bash "$kit/template/cordee/bin/cordee" deploy https://example.test/kit v10.0.0
  lacks '  AGENTS.md'
  lacks '  cordee/README.md'
  lacks '.gitkeep'
  says '  cordee/config.yml'
  [ ! -e cordee/bin/sdd ] && [ ! -e cordee/modules/.gitkeep ]
  cmp -s cordee/WORKFLOW.md "$kit/template/cordee/WORKFLOW.md"
  cmp -s cordee/GETTING-STARTED.md "$kit/template/cordee/GETTING-STARTED.md"
  cmp -s cordee/REFERENCE.md "$kit/template/cordee/REFERENCE.md"
  grep -qF '<!-- cordee -->' AGENTS.md && grep -qF '# Ours' AGENTS.md && grep -qF '# Footer' AGENTS.md
  [ "$(head -1 cordee/README.md)" = 'Deployed from https://example.test/kit v10.0.0.' ]
  grep -qF '# Our map' cordee/README.md
  [ "$(cat cordee/config.yml)" = 'batch-lines: 150' ]
}

test_deploy_asks_the_forge_when_origin_names_none() {
  new_repo app
  git remote add origin https://git.example.test/acme/github-tools.git
  fails bash "$kit/template/cordee/bin/cordee" deploy https://example.test/kit v9.9.9
  says '--forge gitlab'
  [ ! -e cordee ]
  succeeds bash "$kit/template/cordee/bin/cordee" deploy https://example.test/kit v9.9.9 --forge gitlab
  [ -f .gitlab-ci.yml ] && [ ! -e .github ]
}

test_deploy_refuses_a_kit_inside_the_repo() {
  fails bash cordee/bin/cordee deploy https://example.test/kit v9.9.9 --forge github
  says "the kit's own clone"
  cp -R "$kit/template" kit
  fails bash kit/cordee/bin/cordee deploy https://example.test/kit v9.9.9 --forge github
  rm -rf kit
  [ -z "$(git status --porcelain)" ]
}

test_over_max_lines_blocks_an_agent_warns_a_human() {
  echo 'More intent.' >> cordee/modules/search.md
  seq 1 211 > src/search/big.py
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 211 changed lines of code and tests, over 200 (the kit's default) by more than 5%."
  succeeds git commit -qm 'Add a big search'
  says 'Warnings only'
}

test_up_to_five_percent_over_only_notes() {
  echo 'More intent.' >> cordee/modules/search.md
  seq 1 210 > src/search/big.py
  git add -A
  succeeds bash cordee/bin/cordee audit
  says "NOTE 210 changed lines of code and tests, over 200 (the kit's default) but within 5%."
}

test_the_config_sets_the_batch_lines_of_the_repo() {
  echo 'batch-lines: 100  # small steps' > cordee/config.yml
  git add -A
  git commit -qm 'Keep batches small' 2> /dev/null
  echo 'More intent.' >> cordee/modules/search.md
  seq 1 105 > src/search/big.py
  git add -A
  succeeds bash cordee/bin/cordee audit
  says 'NOTE 105 changed lines of code and tests, over 100 (batch-lines in cordee/config.yml) but within 5%.'
  seq 1 300 > src/search/big.py
  echo 'batch-lines: 500' > cordee/config.yml
  git add -A
  succeeds bash cordee/bin/cordee audit
  says 'NOTE cordee/config.yml: batch-lines goes from 100 to 500 in this batch.'
  git commit -q --no-verify -m 'Add a big search, allow bigger batches'
  seq 1 600 > src/search/big.py
  echo 'More.' >> cordee/modules/search.md
  git add -A
  succeeds bash cordee/bin/cordee audit
  lacks 'batch-lines goes from'
  echo 'batch-lines: lots' > cordee/config.yml
  git add -A
  fails bash cordee/bin/cordee audit
  says 'ERROR cordee/config.yml: batch-lines is lots. Write a number of lines, such as 200.'
  git commit -q --no-verify -m 'Allow lots'
  echo 'batch-lines: 150' > cordee/config.yml
  git add -A
  succeeds bash cordee/bin/cordee audit
  says 'NOTE cordee/config.yml: batch-lines goes from 200 to 150 in this batch.'
}

test_a_contract_sets_the_batch_lines_of_its_module() {
  echo 'batch-lines: 300' > cordee/config.yml
  printf -- '---\ngoverns: [src/search/]\nbatch-lines: 50\n---\n# search\n' > cordee/modules/search.md
  printf -- '---\ngoverns: [src/import]\nbatch-lines: 400\n---\n# import\n' > cordee/modules/import.md
  git add -A
  git commit -qm 'Set the batch size of each module' 2> /dev/null
  echo 'More intent.' >> cordee/modules/import.md
  seq 1 350 > src/import/big.py
  git add -A
  succeeds bash cordee/bin/cordee audit
  git reset -q --hard
  git clean -qfd
  echo 'More intent.' >> cordee/modules/search.md
  seq 1 60 > src/search/big.py
  git add -A
  fails bash cordee/bin/cordee audit
  says 'SIZE 60 changed lines of code and tests, over 50 (batch-lines in cordee/modules/search.md) by more than 5%.'
  # Raised in the batch itself, it holds at once, with a note for the human.
  sed 's/batch-lines: 50/batch-lines: 100/' cordee/modules/search.md > cordee/modules/search.tmp
  mv cordee/modules/search.tmp cordee/modules/search.md
  git add -A
  succeeds bash cordee/bin/cordee audit
  says 'NOTE cordee/modules/search.md: batch-lines goes from 50 to 100 in this batch.'
  # Raised alone, it gets the note too.
  git reset -q --hard
  git clean -qfd
  sed 's/batch-lines: 50/batch-lines: 1000/' cordee/modules/search.md > cordee/modules/search.tmp
  mv cordee/modules/search.tmp cordee/modules/search.md
  git add -A
  succeeds bash cordee/bin/cordee audit
  says 'NOTE cordee/modules/search.md: batch-lines goes from 50 to 1000 in this batch.'
}

test_markdown_git_files_and_lockfiles_do_not_count() {
  echo 'More intent.' >> cordee/modules/search.md
  echo two >> src/search/a.py
  seq 1 300 > notes.md
  seq 1 300 > poetry.lock
  seq 1 300 > .gitignore
  git add -A
  succeeds bash cordee/bin/cordee audit
}

test_code_marked_binary_still_counts() {
  echo 'More intent.' >> cordee/modules/search.md
  echo '*.py binary' > .gitattributes
  seq 1 211 > src/search/big.py
  head -c 3000 /dev/zero > src/search/logo.png
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 211 changed lines of code and tests, over 200 (the kit's default) by more than 5%."
  says 'NOTE src/search/big.py: an attribute marks it binary, but it is text.'
  lacks 'NOTE src/search/logo.png'
}

test_a_rename_counts_only_its_edits() {
  seq 1 300 > src/search/big.py
  seq 1 300 > notes.md
  git add -A
  git commit -qm 'Add a big file' 2> /dev/null
  echo 'More intent.' >> cordee/modules/search.md
  git mv src/search/big.py src/search/large.py
  git add -A
  succeeds bash cordee/bin/cordee audit
  seq 1 211 >> src/search/large.py
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 211 changed lines of code and tests, over 200 (the kit's default) by more than 5%."
  echo '*.py binary' > .gitattributes
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 211 changed lines of code and tests"
  says 'NOTE src/search/large.py: an attribute marks it binary, but it is text.'
  # Prose renamed to code counts whole.
  git reset -q --hard
  git clean -qfd
  echo 'More intent.' >> cordee/modules/search.md
  git mv notes.md src/search/notes.py
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 300 changed lines of code and tests"
  echo '*.py binary' > .gitattributes
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 300 changed lines of code and tests"
}

test_blank_lines_do_not_count() {
  echo 'More intent.' >> cordee/modules/search.md
  seq 1 211 | awk '{ print; print ""; print "  " }' > src/search/big.py
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 211 changed lines of code and tests, over 200 (the kit's default) by more than 5%."
  git commit -qm 'Add a big search' 2> /dev/null
  echo 'More intent.' >> cordee/modules/search.md
  grep -v '^ *$' src/search/big.py > "$tmp/big.py"
  mv "$tmp/big.py" src/search/big.py
  git add -A
  succeeds bash cordee/bin/cordee audit
  lacks 'changed lines'
}

test_a_batch_of_many_files_counts_them_all() {
  for n in $(seq 1 120); do seq "$n" $((n + 20)) > "src/search/f$n.py"; done
  git add -A
  git commit -qm 'Add many files' 2> /dev/null
  echo 'More intent.' >> cordee/modules/search.md
  for n in $(seq 1 120); do git mv "src/search/f$n.py" "src/search/g$n.py"; echo more >> "src/search/g$n.py"; done
  seq 1 100 > src/search/more.py
  git add -A
  fails bash cordee/bin/cordee audit
  says "SIZE 220 changed lines of code and tests"
}

# Each contract costs a few git calls, much slower on Windows: over 3 s there, contracts.py is to cache git show.
test_audit_takes_under_3_s_with_40_contracts() {
  local n LC_ALL=C TIMEFORMAT=%R
  mkdir tests
  for n in $(seq 1 38); do
    mkdir "src/m$n"
    echo one > "src/m$n/a.py"
    echo "def test_m$n(): pass" > "tests/test_m$n.py"
    contract "m$n" "src/m$n/, tests/test_m$n.py"
    echo "- Works: [test_m$n](/tests/test_m$n.py)" >> "cordee/modules/m$n.md"
  done
  git add -A
  git commit -qm 'Add 38 modules' 2> /dev/null
  echo two >> src/m7/a.py
  echo 'More intent.' >> cordee/modules/m7.md
  git add -A
  { time bash cordee/bin/cordee audit > /dev/null 2>&1; } 2> "$out"
  awk '{ exit !($1 < 3) }' "$out" || { echo "    audit took $(cat "$out") s with 40 contracts"; return 1; }
}

test_two_modules_block_an_agent() {
  echo 'More intent.' >> cordee/modules/search.md
  echo 'More intent.' >> cordee/modules/import.md
  echo two >> src/search/a.py
  echo two >> src/import/a.py
  git add -A
  fails bash cordee/bin/cordee audit
  says 'SIZE the batch changes code of 2 modules.'
}

test_large_batch_lifts_both_limits() {
  echo 'More intent.' >> cordee/modules/search.md
  echo 'More intent.' >> cordee/modules/import.md
  seq 1 211 > src/search/big.py
  echo two >> src/import/a.py
  git add -A
  printf 'Big\n\nAgent-Assisted: yes\nLarge-Batch: one rename across both modules\n' > "$msg"
  succeeds bash cordee/bin/cordee audit --message "$msg"
  says "NOTE 212 changed lines of code and tests, over 200 (the kit's default): Large-Batch lifts it."
  says 'NOTE the batch changes code of 2 modules: Large-Batch lifts it.'
}

test_touched_lists_each_module_with_its_lines() {
  printf 'two\nthree\n' >> src/search/a.py
  echo '# search' >> cordee/modules/search.md
  echo two >> src/import/a.py
  echo doc > README.md
  git add -A
  git commit -qm 'Change both' 2> /dev/null
  [ "$(bash cordee/bin/cordee touched)" = "$(printf 'import\t1\nsearch\t3')" ]
}

# Commits a line in module $1's code as author $2.
commit_as() {
  echo "$2" >> "src/$1/a.py"
  git add -A
  GIT_AUTHOR_NAME=$2 GIT_AUTHOR_EMAIL=$(tr 'A-Z ' 'a-z.' <<< "$2")@example.test git commit -qm "Change $1" 2> /dev/null
}

test_brief_spots_a_dev_s_first_batch_in_a_module() {
  git commit -q --amend --no-edit --no-verify --author='Ann Lee <ann.lee@example.test>'
  commit_as search 'Bob Roy'
  commit_as search 'Bob Roy'
  commit_as search Carl
  commit_as search Carl
  commit_as search Carl
  commit_as search Dan
  commit_as import Dev
  succeeds bash cordee/bin/cordee brief search
  [ "$(cat "$out")" = 'First batch of yours in search.
Who delivered there most: Carl, Bob Roy, Ann Lee.' ]
}

test_brief_is_silent_in_a_known_module() {
  git commit -q --amend --no-edit --no-verify --author='Ann Lee <ann.lee@example.test>'
  commit_as search Carl
  # The dev's own commit, under another case of the same address.
  echo dev >> src/search/a.py
  git add -A
  GIT_AUTHOR_EMAIL=DEV@example.test git commit -qm 'Change search' 2> /dev/null
  succeeds bash cordee/bin/cordee brief search
  [ ! -s "$out" ]
  # A mailmap that moves the dev to a new address maps their own identity too.
  echo 'Dev <dev@new.test> <dev@example.test>' > .mailmap
  succeeds bash cordee/bin/cordee brief search
  [ ! -s "$out" ]
  succeeds bash cordee/bin/cordee brief nothing
  [ ! -s "$out" ]
}

test_brief_shows_quizzes_waiting_in_other_worktrees() {
  git worktree add -q "$tmp/other" -b other
  git worktree add -q "$tmp/third" -b third
  succeeds bash cordee/bin/cordee brief
  [ ! -s "$out" ]
  # The dev's own quiz, in the worktree they run brief from, does not wait.
  touch "$tmp/other/QUIZ.md" QUIZ.md
  succeeds bash cordee/bin/cordee brief
  [ "$(wc -l < "$out")" -eq 1 ] && says 'A quiz waits for your answers in ' && says '/other.'
}

# Pushes branch $1 with a commit by $2, committed $3 hours ago.
push_branch() {
  git checkout -q -b "$1" main
  GIT_COMMITTER_DATE="$(($(date +%s) - $3 * 3600 - 60)) +0000" commit_as search "$2"
  git push -q origin "$1"
  git checkout -q main
}

# A remote with origin/HEAD on main, which holds a commit by Bob Roy pushed again as branch done. It is 72 hours old,
# so that only its merge keeps it out of brief.
remote() {
  git init -q --bare "$tmp/origin.git"
  git remote add origin "$tmp/origin.git"
  GIT_COMMITTER_DATE="$(($(date +%s) - 72 * 3600)) +0000" commit_as search 'Bob Roy'
  git push -q origin main main:done
}

test_brief_shows_branches_waiting_for_review_with_their_author() {
  remote
  # Names in the reverse order of their age, so that only the dates sort them.
  push_branch fresh Carl 3
  push_branch late Carl 4
  push_branch mine Dev 10
  push_branch stale 'Bob Roy' 72
  # Abandoned past 14 days, or a bot's: neither waits for anyone.
  push_branch abandoned Carl 337
  push_branch deps 'dependabot[bot]' 10
  push_branch renovate 'Renovate Bot' 10
  succeeds bash cordee/bin/cordee brief
  [ ! -s "$out" ]
  git remote set-head origin main
  succeeds bash cordee/bin/cordee brief
  [ "$(cat "$out")" = 'origin/stale waits for a review for 3 days, see Bob Roy.
origin/late waits for a review for 4 hours, see Carl.' ]
}

test_the_config_sets_how_long_a_branch_waits() {
  remote
  git remote set-head origin main
  push_branch fresh Carl 3
  push_branch stale 'Bob Roy' 72
  printf 'review-wait-hours: 2\nabandoned-days: 2  # a two-day sprint\n' > cordee/config.yml
  git add -A
  git commit -qm 'Wait less' 2> /dev/null
  succeeds bash cordee/bin/cordee brief
  [ "$(cat "$out")" = 'origin/fresh waits for a review for 3 hours, see Carl.' ]
  echo 'abandoned-days: two' > cordee/config.yml
  git add -A
  git commit -qm 'Mistype the setting' 2> /dev/null
  fails bash cordee/bin/cordee brief
  says 'ERROR cordee/config.yml: abandoned-days is two. Write a whole number, such as 14.'
}

test_brief_says_three_lines_at_most() {
  git commit -q --amend --no-edit --no-verify --author='Ann Lee <ann.lee@example.test>'
  remote
  git remote set-head origin main
  push_branch late Carl 5
  push_branch stale 'Bob Roy' 72
  git worktree add -q "$tmp/other" -b other
  git worktree add -q "$tmp/third" -b third
  touch "$tmp/other/QUIZ.md" "$tmp/third/QUIZ.md"
  succeeds bash cordee/bin/cordee brief search
  [ "$(sed -n 3p "$out")" = 'origin/stale waits for a review for 3 days, see Bob Roy.' ]
  lacks 'origin/late'
  # The dev's first batch in search comes after what waits.
  [ "$(sed -n 4p "$out")" = 'First batch of yours in search.' ]
}

test_quiet_hides_a_green_output_and_shows_the_end_of_a_red_one() {
  succeeds bash cordee/bin/cordee quiet seq 100
  [ "$(cat "$out")" = 'ok: seq 100 (100 lines hidden)' ]
  fails bash cordee/bin/cordee quiet sh -c 'seq 100; exit 3'
  [ "$(head -n 1 "$out")" = 71 ] && [ "$(tail -n 1 "$out")" = "FAIL (3): sh -c seq 100; exit 3" ]
}

test_a_command_missing_an_argument_prints_the_usage() {
  for command in hook 'audit --message' 'audit --range' 'audit --bogus' quiet; do
    fails bash cordee/bin/cordee $command
    says 'usage: bash cordee/bin/cordee'
  done
}

test_audit_notes_the_markdown_ratio() {
  succeeds bash cordee/bin/cordee audit
  says 'NOTE 8 lines of markdown for 2 lines of governed code, ratio 4.00 (guideline: at most 1).'
}

test_audit_points_out_governs_paths_that_match_nothing() {
  contract search src/serch/
  git add -A
  succeeds bash cordee/bin/cordee audit
  says 'NOTE cordee/modules/search.md: src/serch/ matches no tracked file, a typo or code still to come.'
}

# YAML's other ways to write a list: one path, or "- path" lines, flush or indented. The next key is no path.
test_governs_reads_a_scalar_or_a_block_list() {
  printf -- '---\ngoverns: src/search/\nrisk: high\n---\n# search\n' > cordee/modules/search.md
  printf -- '---\ngoverns:\n# owned here\n  - src/import/a.py  # the code\n- lib/\nrisk: high\n---\n# import\n' \
    > cordee/modules/import.md
  git add -A
  git commit -qm 'Write governs as YAML lists' 2> /dev/null
  echo two >> src/import/a.py
  git add -A
  fails bash cordee/bin/cordee audit
  says 'DRIFT cordee/modules/import.md: src/import/a.py changed'
  says 'NOTE cordee/modules/import.md: lib/ matches no tracked file'
  lacks 'risk: matches'
  lacks 'high matches'
  lacks 'here matches'
  lacks 'code matches'
}

test_a_governs_path_outside_the_repo_says_what_to_do() {
  contract search ../shared/
  git add -A
  fails git commit -qm 'Share search'
  says 'ERROR cordee/modules/search.md: governs ../shared/, outside the repo. Write each path from the repo root.'
  lacks 'fatal'
  contract search /shared/
  git add -A
  fails git commit -qm 'Share search'
  says 'ERROR cordee/modules/search.md: governs /shared/, outside the repo.'
}

