test_a_quiz_written_for_the_batch_marks_an_agent_batch() {
  batch
  write_quiz src/search/a.py 'A B C'
  fails git commit -qm 'Change search'
  says 'Agent-Assisted: yes is added to the message'
  says 'Tick exactly one box for question 1'
  answer A B C
  succeeds git commit -qm 'Change search'
  git log -1 --format=%B | grep -qx 'Agent-Assisted: yes'
  git log -1 --format=%B | grep -qx 'Quiz: 3/3, covers 1/1'
  # A key written for an earlier state of the batch marks nothing: the human's own commit.
  echo three >> src/search/a.py
  echo 'Even more intent.' >> cordee/modules/search.md
  git add -A
  write_quiz src/search/a.py 'A'
  echo four >> src/search/a.py
  git add -A
  succeeds git commit -qm 'Change search again'
  lacks 'Agent-Assisted: yes is added'
}

test_the_config_lists_the_agent_emails() {
  printf 'agent-emails:\n  - agent+bot@example.test\n' > cordee/config.yml
  git add -A
  git commit -qm 'Name our agent' 2> /dev/null
  echo two >> src/search/a.py
  git add -A
  fails git commit -qm 'Change search' -m 'Co-Authored-By: Our Agent <agent+bot@example.test>'
  says 'Refused, agent-assisted batch'
  # The list replaces the kit's: Claude Code's address is a human's here.
  succeeds git commit -qm 'Change search' -m 'Co-Authored-By: Claude <noreply@anthropic.com>'
  [ "$(git log -1 --format=%s)" = 'Change search' ]
  # A batch that takes the address out is still judged by the list it had.
  echo three >> src/search/a.py
  echo 'agent-emails: []' > cordee/config.yml
  git add -A
  fails git commit -qm 'Forget our agent' -m 'Co-Authored-By: Our Agent <agent+bot@example.test>'
  says 'Refused, agent-assisted batch'
}

test_the_config_lists_what_is_not_code() {
  printf 'not-code:\n  - generated/\n' > cordee/config.yml
  git add -A
  git commit -qm 'Generated code is no code' 2> /dev/null
  mkdir generated
  seq 1 300 > generated/schema.py
  git add -A
  succeeds bash cordee/bin/cordee audit
  lacks 'SIZE'
  # The kit's lock files count again: the list replaces the kit's.
  seq 1 300 > Gemfile.lock
  git add -A
  fails bash cordee/bin/cordee audit
  says 'SIZE 300 changed lines of code and tests'
  # A batch that widens the list is judged by the list it had.
  git rm -q --cached Gemfile.lock
  printf 'not-code:\n  - generated/\n  - src/\n' > cordee/config.yml
  seq 1 300 > src/search/big.py
  echo 'More intent.' >> cordee/modules/search.md
  git add cordee src
  fails bash cordee/bin/cordee audit
  says 'SIZE 301 changed lines of code and tests'
}

test_doctor_says_what_to_fix() {
  export CLAUDE_CONFIG_DIR=$tmp/claude XDG_DATA_HOME=$tmp/share COPILOT_HOME=$tmp/copilot
  succeeds bash cordee/bin/cordee doctor
  lacks 'NOTE'
  says 'tokens: off'
  echo 'tokens: true' > cordee/config.yml
  bash cordee/bin/cordee install-hook > /dev/null
  succeeds bash cordee/bin/cordee doctor
  lacks 'NOTE'
  says 'ledger: on'
  says 'replies read in 30 days: antigravity 0, claude_code 0, copilot 0, kilo_code 0, opencode 0'
  says 'audit: '
  hooks=$(git rev-parse --git-path hooks)
  echo '[ ! -f cordee/bin/ledger ] || bash cordee/bin/ledger record' > "$hooks/post-commit"
  rm "$hooks/pre-push"
  : > "$(git rev-parse --git-path info/exclude)"
  echo 'Deployed from https://example.test/kit v0.1.0.' > cordee/README.md
  git config cordee.ledger false
  succeeds bash cordee/bin/cordee doctor
  says 'NOTE the post-commit hook does not run cordee/bin/cordee committed'
  says 'NOTE the pre-push hook does not run cordee/bin/ledger sync'
  lacks 'NOTE the commit-msg hook'
  lacks 'does not run cordee/bin/ledger record'
  says 'NOTE QUIZ.md is not kept out of git'
  says 'NOTE cordee/README.md says it was deployed from v0.1.0'
  says 'ledger: off'
}

# doctor reads the kit's version from VERSION, which the human raises before each tag.
test_the_version_is_the_last_tag_or_newer() {
  local tag version
  tag=$(git -C "$kit" describe --tags --abbrev=0 --match 'v[0-9]*')
  version=$(sed -n 's/^VERSION = "\(.*\)"$/\1/p' "$kit/template/cordee/bin/harness/__init__.py")
  [ "$(printf '%s\n' "${tag#v}" "$version" | sort -t . -n -k 1,1 -k 2,2 -k 3,3 | head -1)" = "${tag#v}" ] || {
    echo "    VERSION $version is older than the tag $tag"; return 1; }
}

test_a_human_co_author_named_claude_is_human() {
  echo two >> src/search/a.py
  git add -A
  succeeds git commit -qm 'Change search' -m 'Co-Authored-By: Claude Dupont <claude.dupont@example.fr>'
}

names=${*:-$(declare -F | awk '$3 ~ /^test_/ { print $3 }')}
failed=0
for t in $names; do
  ( set -e; setup; "$t" )
  # Quiet when green: the agent that runs the tests reads every line.
  if [ $? -ne 0 ]; then echo "FAIL $t"; failed=$((failed + 1)); fi
done
echo "$failed failed of $(wc -w <<< "$names" | tr -d ' ')"
[ "$failed" -eq 0 ]
