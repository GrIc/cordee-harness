#!/usr/bin/env bash
# Runs template/cordee/bin/cockpit against fake agent logs. Usage: bash test/cockpit [test_name...]
set -u

kit=$(cd "$(dirname "$0")/.." && pwd)

# Empty log homes for both agents, and a repo path. The window runs from 10:00 to 11:00 UTC.
setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  repo=$tmp/repo
  mkdir "$repo"
  export CLAUDE_CONFIG_DIR=$tmp/claude XDG_DATA_HOME=$tmp/share
  # The Python the launchers find, for the fixtures.
  for python in python3 python 'py -3'; do
    $python -c 'import sys; sys.exit(sys.version_info < (3, 10))' > /dev/null 2>&1 && break
  done
  # The folder from the path as Python reads it, which Git Bash rewrites on the way. No newline: Windows would add \r.
  name='import re, sys; sys.stdout.write(re.sub(r"[^A-Za-z0-9]", "-", sys.argv[1]))'
  claude=$CLAUDE_CONFIG_DIR/projects/$($python -c "$name" "$repo")
  mkdir -p "$claude/s1/subagents"
}

# The UTC timestamp $1 seconds ago, by GNU date or BSD date.
ago() {
  local when=$(($(date +%s) - $1))
  date -u -d "@$when" +%Y-%m-%dT%H:%M:%SZ 2> /dev/null || date -u -r "$when" +%Y-%m-%dT%H:%M:%SZ
}

usage() { bash "$kit/template/cordee/bin/cockpit" usage "$repo" 1792749600 1792753200 | tr '\t' ' '; }
fails() { if [ "$1" != "$2" ]; then printf '    expected: %s\n    got:      %s\n' "$2" "$1"; return 1; fi; }

# A Claude Code reply, its keys in Claude Code's order: id, time, model, input, output, cache read, cache write.
reply() {
  printf '{"parentUuid":null,"message":{"model":"%s","id":"%s","role":"assistant","content":[],' "$3" "$1"
  printf '"usage":{"input_tokens":%s,"output_tokens":%s,"cache_read_input_tokens":%s,' "$4" "$5" "$6"
  printf '"cache_creation_input_tokens":%s}},"type":"assistant","timestamp":"%s"}\n' "$7" "$2"
}

test_claude_code_splits_writer_and_reviewer_once_per_reply() {
  {
    reply m1 2026-10-23T10:30:00Z claude-opus-5-5 1 10 100 1000
    reply m1 2026-10-23T10:30:00Z claude-opus-5-5 1 10 100 1000
    reply m2 2026-10-23T09:30:00Z claude-opus-5-5 1 10 100 1000
    reply m3 2026-10-23T10:40:00Z '<synthetic>' 0 0 0 0
    # A sub-agent's result carries its usage, but is no reply.
    echo '{"message":{"role":"user","content":"done"},"toolUseResult":{"usage":{"input_tokens":9}},'\
'"timestamp":"2026-10-23T10:45:00Z"}'
    # A tool call whose input holds a usage and a timestamp of its own.
    reply m5 2026-10-23T10:35:00Z claude-opus-5-5 1 10 100 1000 |
      sed 's/"content":\[\]/"content":[{"input":{"usage":{"input_tokens":7},"timestamp":"2026-10-23T09:00:00Z"}}]/'
    reply m4 2026-10-23T10:59:00Z claude-opus-5-5 1 10 100 1000 | cut -c 1-150 | tr -d '\n'
  } > "$claude/s1.jsonl"
  reply r1 2026-10-23T10:50:00Z claude-sonnet-5-5 2 20 200 2000 > "$claude/s1/subagents/agent-a.jsonl"
  echo '{"agentType":"general-purpose","description":"Review batch 2, write quiz"}' \
    > "$claude/s1/subagents/agent-a.meta.json"
  fails "$(usage)" 'reviewer claude-sonnet-5-5 1 2 20 200 2000
writer claude-opus-5-5 2 2 20 200 2000'
}

# A session that revives a sub-agent of another session links its log; once the folder moves, the link breaks.
test_claude_code_reads_a_revived_sub_agent_once() {
  real_repo
  mkdir -p "$claude/s2/subagents" "$tmp/moved"
  reply r1 2026-10-23T10:50:00Z claude-sonnet-5-5 0 0 0 500 > "$claude/s1/subagents/agent-a.jsonl"
  reply r2 2026-10-23T10:55:00Z claude-sonnet-5-5 0 0 0 500 > "$tmp/moved/agent-b.jsonl"
  meta='{"agentType":"general-purpose","description":"Review batch 2"}'
  echo "$meta" > "$claude/s1/subagents/agent-a.meta.json"
  for agent in a b; do echo "$meta" > "$claude/s2/subagents/agent-$agent.meta.json"; done
  # Git Bash copies the file unless told to link.
  MSYS=winsymlinks:nativestrict ln -s "$claude/s1/subagents/agent-a.jsonl" "$claude/s2/subagents/agent-a.jsonl"
  MSYS=winsymlinks:nativestrict ln -s "$tmp/moved/agent-b.jsonl" "$claude/s2/subagents/agent-b.jsonl"
  rm "$tmp/moved/agent-b.jsonl"
  bash "$kit/template/cordee/bin/cockpit" report "$repo" 1792749600 1792753200 | tr -s ' ' > "$tmp/out"
  grep -q '^reviewer claude-sonnet-5-5 1 ' "$tmp/out" || { sed 's/^/    | /' "$tmp/out"; return 1; }
}

# As Windows answers before Python is installed: the commit-msg hook stops and says what to install, as install-hook
# does; what the ledger asks and the hints say nothing, and a push goes through.
test_without_python_only_the_commit_msg_hook_stops() {
  export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
  git init -q --bare "$tmp/origin.git"
  git clone -q "$tmp/origin.git" "$repo" 2> /dev/null && cd "$repo"
  git config user.email dev@example.test && git config user.name Dev
  mkdir cordee && cp -R "$kit/template/cordee/bin" cordee/
  bash cordee/bin/cordee install-hook > /dev/null
  mkdir "$tmp/bin"
  for python in python3 python py; do
    printf '#!/bin/sh\necho Python was not found >&2\nexit 9009\n' > "$tmp/bin/$python"
    chmod +x "$tmp/bin/$python"
  done
  PATH=$tmp/bin:$PATH
  text='Cordee needs Python 3.10 or later: install it (https://www.python.org/downloads/), then try again.'
  if bash cordee/bin/cordee install-hook 2> "$tmp/err"; then return 1; fi
  fails "$(cat "$tmp/err")" "$text"
  git add -A
  if git commit -qm Start 2> "$tmp/err"; then return 1; fi
  fails "$(cat "$tmp/err")" "$text"
  reply m1 2026-10-23T10:30:00Z claude-opus-5-5 1 10 100 1000 > "$claude/s1.jsonl"
  fails "$(git commit -q --no-verify -m Start 2>&1)" ''
  fails "$(git push -q origin HEAD:main 2>&1)" ''
  fails "$(usage 2>&1)" ''
  fails "$(bash cordee/bin/cockpit hints 2>&1)" ''
}

# An opencode base at $1, with a writer session and its reviewer child, one reply each, in $repo.
opencode_base() {
  mkdir -p "$(dirname "$1")"
  $python - "$1" "$repo" <<'PY'
import json, sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("create table session (id, parent_id, directory, title)")
db.execute("create table message (id, session_id, time_created, data)")
sessions = [("s1", None, sys.argv[2], "Build"), ("s2", "s1", sys.argv[2], "Review the batch")]
db.executemany("insert into session values (?, ?, ?, ?)", sessions)
for i, (session, role) in enumerate([("s1", "assistant"), ("s1", "user"), ("s2", "assistant")]):
    tokens = {"input": 5, "output": 4, "reasoning": 3, "cache": {"read": 50, "write": 9}}
    data = {"role": role, "agent": "build", "providerID": "openrouter", "modelID": "glm-4.6", "tokens": tokens}
    db.execute("insert into message values (?, ?, ?, ?)", (i, session, 1792751400000, json.dumps(data)))
db.commit()
PY
}

test_opencode_child_session_is_the_reviewer() {
  opencode_base "$XDG_DATA_HOME/opencode/opencode.db"
  fails "$(usage)" 'reviewer glm-4.6 1 5 7 50 9
writer glm-4.6 1 5 7 50 9'
}

test_kilo_code_reads_like_opencode() {
  opencode_base "$XDG_DATA_HOME/kilo/kilo.db"
  fails "$(usage)" 'reviewer glm-4.6 1 5 7 50 9
writer glm-4.6 1 5 7 50 9'
}

# Antigravity CLI's index and transcripts, in $tmp/home: a session in $repo that spawns a reviewer next to a command,
# then two agents in one reply, one in each form of the call, and a session in a folder whose name starts like the
# repo's.
test_antigravity_names_the_reviewer_from_the_call_that_spawned_it() {
  $python - "$tmp/home/.gemini/antigravity-cli" "$repo" <<'PY'
import json, os, pathlib, sqlite3, sys
home, repo = sys.argv[1:]
os.makedirs(home)
db = sqlite3.connect(os.path.join(home, "conversation_summaries.db"))
db.execute("create table conversation_summaries (conversation_id, parent_conversation_id, agent_name, workspace_uris)")
uri = json.dumps([pathlib.Path(repo).as_uri()])
db.executemany("insert into conversation_summaries values (?, ?, ?, ?)", [
    ("a1", "", "", uri), ("b2", "a1", "self", uri), ("c3", "a1", "research", uri), ("d4", "a1", "research", uri),
    ("e5", "", "", json.dumps([pathlib.Path(repo + "-other").as_uri()]))])
db.commit()


def reply(minute, input=0, calls=()):
    step = {"type": "PLANNER_RESPONSE", "created_at": f"2026-10-23T10:{minute:02}:00Z"}
    if input:
        step.update(input_tokens=input, output_tokens=4, cache_read_tokens=50)
    return dict(step, tool_calls=[{"name": name, "args": args} for name, args in calls])


def created(*ids):
    return {"type": "GENERIC", "content": "".join(f'{{\n  "conversationId":  "{cid}"\n}}' for cid in ids)}


picked = "The user changed setting `Model Selection` from None to Gemini 4 Argon (High). No need to comment."
# transcript.jsonl writes each argument of a call as JSON, transcript_full.jsonl as is.
logs = {
    "a1": ("transcript.jsonl", [
        {"type": "USER_INPUT", "content": f"<USER_SETTINGS_CHANGE>\n{picked}\n</USER_SETTINGS_CHANGE>"},
        reply(4, 5), reply(1, 5, [("run_command", {}), ("invoke_subagent", {
            "Role": '"Batch Reviewer and Quiz Author"', "Model": '"flash"', "TypeName": '"self"'})]),
        {"type": "GENERIC", "content": "Command output: ok"}, created("b2"),
        reply(2, 5, [("invoke_subagent", {"Subagents": json.dumps([{"Prompt": "Read"}])}),
                     ("invoke_subagent", {"Model": '"pro"'})]),
        created("c3"), created("d4"), reply(3), reply(59, 5) | {"created_at": "2026-10-23T11:01:00Z"}]),
    "b2": ("transcript_full.jsonl", [reply(5, 7)]),
    "c3": ("transcript_full.jsonl", [reply(6, 8)]),
    "d4": ("transcript_full.jsonl", [reply(7, 9)]),
    "e5": ("transcript.jsonl", [reply(8, 100)]),
}
for cid, (name, steps) in logs.items():
    folder = os.path.join(home, "brain", cid, ".system_generated", "logs")
    os.makedirs(folder)
    with open(os.path.join(folder, name), "w") as file:
        file.writelines(json.dumps(step) + "\n" for step in steps)
        # A line Antigravity is still writing.
        file.write('{"type": "PLANNER_RESPONSE", "input_')
PY
  fails "$(HOME=$tmp/home USERPROFILE=$tmp/home usage)" 'agent:research Gemini 4 Argon (High) 1 8 4 50 0
agent:research pro 1 9 4 50 0
reviewer flash 1 7 4 50 0
writer Gemini 4 Argon (High) 3 15 12 150 0'
}

