#!/usr/bin/env bash
# SDD-Fabrik checks: drift between contracts and code, batch size, and the quiz. See sdd/WORKFLOW.md.
set -euf  # f: governs paths go to git as pathspecs, the shell must not expand them

# An agent batch up to 5% over only gets a note.
MAX_LINES=200

# Files that count neither in the size nor in what the quiz covers: prose and lock files.
NOT_CODE='\.md$|\.lock$|lock\.json$|lock\.yaml$'

# Co-author addresses that mark an agent batch, as an ERE alternation. Names are not enough: Claude is also a
# first name. Any agent can mark its batch with Agent-Assisted: yes.
AGENT_EMAILS='noreply@anthropic\.com|noreply@openai\.com|aider@aider\.chat'

# A pushed branch waits for a review once its last commit is this old.
REVIEW_WAIT_HOURS=4

EMPTY_TREE=$(git hash-object -t tree --stdin < /dev/null)

# Paths with accents print as they are, not as quoted octal escapes.
git() { command git -c core.quotePath=false "$@"; }

is_agent() {
  grep -Eiq "^Agent-Assisted:[[:space:]]*yes[[:space:]]*\$|^Co-Authored-By:.*<($AGENT_EMAILS)>" <<< "$1"
}

# Paths listed in a contract's governs, one per line. $1 is a revision path such as HEAD:sdd/modules/search.md.
governs() {
  git show "$1" | tr -d "\r\"'" | awk '
    /^---[[:space:]]*$/ { fm++; next }
    fm == 1 && /^governs:/ { on = 1 }
    fm == 1 && on {
      last = /\]/
      sub(/^governs:[[:space:]]*/, "")
      gsub(/[][,]/, " ")
      for (i = 1; i <= NF; i++) print $i
      if (last) on = 0
    }'
}

# Whether the contract at revision path $1 declares risk: high.
risky() {
  git show "$1" 2> /dev/null | tr -d '\r' |
    awk '/^---[[:space:]]*$/ { fm++; next } fm == 1 && /^risk:[[:space:]]*high[[:space:]]*$/ { f = 1 } END { exit !f }'
}

modules() {
  git ls-tree --name-only "$1" sdd/modules/ | awk -F/ 'sub(/\.md$/, "", $NF) { printf "%s%s", sep, $NF; sep = ", " }'
}

# The modules whose code or contract commit $1 changes, each with its changed lines, tab-separated.
touched() {
  local parent contract
  parent=$(git rev-parse -q --verify "$1^" || echo "$EMPTY_TREE")
  for contract in $(git ls-tree -r --name-only "$1" sdd/modules/ | awk '/\.md$/'); do
    git diff --numstat --no-renames "$parent" "$1" -- "$contract" $(governs "$1:$contract") |
      awk -F '\t' -v module="$(basename "$contract" .md)" '
        $1 != "-" { n += $1 + $2 }
        END { if (n) print module "\t" n }'
  done
}

# Drift between the contracts and their code, from $1 to $2 under the message $3. Sets hit (the modules whose code or
# contract changed, joined by ","), high (those of them at high risk) and touched (how many changed code that no
# Spec-Unchanged spares).
drift() {
  local base=$1 tree=$2 msg=$3 module contracts contract paths path broken
  hit= high= touched=0
  for module in $(sed -n 's/^Spec-Unchanged(\([^)]*\)):.*/\1/p' <<< "$msg"); do
    git cat-file -e "$tree:sdd/modules/$module.md" 2> /dev/null ||
      errors="${errors}ERROR Spec-Unchanged($module): no such module. Modules: $(modules "$tree").
"
  done
  # The base's contracts too: a batch that deletes a high-risk contract is one to read twice.
  contracts=$({ git ls-tree -r --name-only "$tree" sdd/modules/; git ls-tree -r --name-only "$base" sdd/modules/; } |
    awk '/\.md$/ && !seen[$0]++')
  for contract in $contracts; do
    module=$(basename "$contract" .md)
    path=
    if git cat-file -e "$tree:$contract" 2> /dev/null; then
      paths=$(governs "$tree:$contract")
      if [ -z "$paths" ]; then
        errors="${errors}ERROR $contract: governs is empty. List the paths this module owns.
"
        continue
      fi
      broken=$(links "$tree" "$contract")
      [ -z "$broken" ] || findings="${findings}$broken
      Fix the link, or the name of the test it points to.
"
      path=$(git diff --name-only --no-renames "$base" "$tree" -- $paths | head -n 1)
    fi
    if [ -n "$path" ] || grep -qxF "$contract" <<< "$changed"; then
      hit=$hit${hit:+,}$module
      # The batch that drops risk: high is still judged at high risk.
      if risky "$tree:$contract" || risky "$base:$contract"; then high=$high${high:+, }$module; fi
    fi
    [ -n "$path" ] || continue
    grep -q "^Spec-Unchanged($module):[[:space:]]*[^[:space:]]" <<< "$msg" && continue
    touched=$((touched + 1))
    grep -qxF "$contract" <<< "$changed" && continue
    findings="${findings}DRIFT $contract: $path changed, its contract did not.
      Update the contract if the code is right, fix the code if it betrays the intent,
      or add 'Spec-Unchanged($module): <reason>' to the message if the behavior is unchanged.
"
  done
}

# The size of the change from $1 to $2 under the message $3: its lines of code and tests, and the modules drift
# counted in touched.
size() {
  local lines
  lines=$(git diff --numstat --no-renames "$1" "$2" |
    NOT_CODE=$NOT_CODE awk -F '\t' '$1 != "-" && $3 !~ ENVIRON["NOT_CODE"] { n += $1 + $2 } END { print n + 0 }')
  if grep -q '^Large-Batch:[[:space:]]*[^[:space:]]' <<< "$3"; then
    [ "$lines" -le "$MAX_LINES" ] ||
      notes="${notes}NOTE $lines changed lines of code and tests, over $MAX_LINES: Large-Batch lifts it.
"
    [ "$touched" -le 1 ] || notes="${notes}NOTE the batch changes code of $touched modules: Large-Batch lifts it.
"
    return 0
  fi
  if [ "$lines" -gt $((MAX_LINES * 105 / 100)) ]; then
    findings="${findings}SIZE $lines changed lines of code and tests, over $MAX_LINES by more than 5%.
      Split the batch, or the human adds 'Large-Batch: <reason>' to the message.
"
  elif [ "$lines" -gt "$MAX_LINES" ]; then
    notes="${notes}NOTE $lines changed lines of code and tests, over $MAX_LINES but within 5%.
"
  fi
  if [ "$touched" -gt 1 ]; then
    findings="${findings}SIZE the batch changes code of $touched modules.
      Split it by module, or the human adds 'Large-Batch: <reason>' to the message.
"
  fi
}

# Markdown that no contract is and no module governs asks little of a quiz: the human reads its diff.
quiz_level() {
  level=normal
  if [ -n "$high" ]; then
    level=high
  elif [ -n "$changed" ] && [ -z "$hit" ] && ! grep -qv '\.md$' <<< "$changed"; then
    level=low
  fi
}

# Checks the change from $1 to $2 (commits or trees) under the commit message $3. Sets changed (the changed files),
# hit, high, level (low, normal or high), errors (fatal for everyone), findings (fatal for agents only) and notes.
check() {
  errors= findings= notes=
  changed=$(git diff --name-only --no-renames "$1" "$2")
  drift "$1" "$2" "$3"
  size "$1" "$2" "$3"
  quiz_level
}

report() {
  printf '%s' "$notes" >&2
  if [ -n "$errors" ]; then
    printf '%s' "$errors$findings" >&2
    return 1
  fi
  [ -n "$findings" ] || return 0
  if is_agent "$1"; then
    printf 'Refused, agent-assisted batch:\n%s' "$findings" >&2
    return 1
  fi
  printf 'Warnings only, this is your own commit:\n%s' "$findings" >&2
}

fingerprint() {
  printf '%s %s' "$(git write-tree)" "$(git rev-parse -q --verify HEAD || echo none)" | git hash-object --stdin
}

quiz_key() { git rev-parse --git-path sdd/quiz-key; }

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

# One tab-separated line per question of QUIZ.md: its number, boxes, ticked boxes, the ticked letter, what its See
# cites, the key's letter for it (- when the key has none among the boxes) and the key's hint. The one reader of the
# key's answers.
questions() {
  tr -d '\r' < QUIZ.md | KEY=$(quiz_key) awk '
    BEGIN { while ((getline line < ENVIRON["KEY"]) > 0) { sub(/\r$/, "", line); key[n++] = line } }
    /^## / { q++; boxes[q] = 0; ticks[q] = 0; pick[q] = "-"; see[q] = "-"; next }
    q && /^See / { see[q] = substr($0, 5); sub(/^ +/, "", see[q]); if (see[q] == "") see[q] = "-" }
    q && /^- \[[ xX]\]/ { boxes[q]++; if (/^- \[[xX]\]/) { ticks[q]++; pick[q] = substr("ABCD", boxes[q], 1) } }
    END {
      for (i = 1; i <= q; i++) {
        right = hint = key[i]
        sub(/ .*/, "", right)
        sub(/^[^ ]* */, "", hint)
        if (length(right) != 1 || !index(substr("ABCD", 1, boxes[i]), right)) right = "-"
        gsub(/\t/, " ", see[i])
        gsub(/\t/, " ", hint)
        printf "%d\t%d\t%d\t%s\t%s\t%s\t%s\n", i, boxes[i], ticks[i], pick[i], see[i], right, hint
      }
    }'
}

# How much of the staged code the quiz cites: "covered total", then the hunks it misses, joined by ", ". $1: one cited
# range per line, its file, first and last line, tab-separated. A hunk that only deletes is met at the line before it
# or the one after, so a deleted file at its line 1.
cover() {
  # The parser reads plain a/ and b/ paths and one hunk per change, whatever the dev's diff settings.
  git diff --cached -U0 --inter-hunk-context=0 --no-renames --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ |
    CITES=$1 NOT_CODE=$NOT_CODE awk '
    BEGIN {
      n = split(ENVIRON["CITES"], rows, "\n")
      for (i = 1; i <= n; i++) { split(rows[i], f, "\t"); file[i] = f[1]; first[i] = f[2] + 0; last[i] = f[3] + 0 }
    }
    /^diff --git / { head = 1; code = 0; next }
    head && /^--- / { path = substr($0, 7) }
    head && /^\+\+\+ / {
      if ($0 != "+++ /dev/null") path = substr($0, 7)
      sub(/\t$/, "", path)
      code = (path !~ ENVIRON["NOT_CODE"])
      head = 0
    }
    /^@@ / && code {
      split($3, side, ",")
      lo = substr(side[1], 2) + 0
      hi = lo
      if (side[2] != "") hi = lo + side[2] - 1
      if (side[2] == "0") hi = lo + 1
      total++
      for (i = 1; i <= n; i++) if (file[i] == path && first[i] <= hi && last[i] >= lo) break
      if (i <= n) covered++
      else { miss = miss sep path ":" lo; sep = ", " }
    }
    END { print covered + 0, total + 0; print miss }'
}

# The reviewer's part: QUIZ.md and its key fit the staged batch. Sets rows, the output of questions; count, its
# questions; ranks, the right letters in order; and coverage, the output of cover. Needs changed and level, set by
# check.
quiz_form() {
  local key i boxes ticks pick see right hint places place file span cites=
  key=$(quiz_key)
  ranks=
  [ -f "$key" ] || fail "QUIZ.md has no key: the reviewer writes it at $key (see sdd/WORKFLOW.md)."
  [ "$(head -n 1 "$key" | tr -d '\r')" = "$(fingerprint)" ] ||
    echo 'NOTE The batch changed since the quiz was written. If your changes touch what it asks, ask for a new one.' >&2
  count=$(grep -c '^## ' QUIZ.md) || :
  if [ "$level" = high ]; then
    [ "$count" -ge 3 ] || fail 'QUIZ.md needs 3 questions or more, each under a "## " heading.'
  else
    [ "$count" -eq 3 ] || fail 'QUIZ.md needs 3 questions, each under a "## " heading.'
  fi
  rows=$(questions)
  while IFS=$'\t' read -r i boxes ticks pick see right hint; do
    places=$(SEE=$see awk 'BEGIN { n = split(ENVIRON["SEE"], p, ", "); for (j = 1; j <= n; j++) print p[j] }')
    [ "$(grep -c . <<< "$places")" -le 3 ] || see=
    while IFS= read -r place; do
      file=${place%:*}
      span=${place##*:}
      case $span in '' | *[!0-9-]* | -* | *- | *-*-*) see= ;; esac
      grep -qxF "$file" <<< "$changed" || see=
      [ -n "$see" ] ||
        fail "Question $i needs a See line citing one to three places of this batch, as 'See a.py:4, b.py:10-12'."
      cites="$cites$file	${span%-*}	${span#*-}
"
    done <<< "$places"
    [ "$boxes" -ge 2 ] && [ "$boxes" -le 4 ] || fail "Question $i needs 2 to 4 boxes."
    [ "$right" != - ] ||
      fail "Question $i has no right box in the key: line $((i + 1)) starts with its letter, A for the first box."
    ranks=$ranks$right
  done <<< "$rows"
  coverage=$(cover "$cites")
}

# Writes under each wrong question of QUIZ.md that has none yet a quoted block, which the parser skips: the key's
# hint, the call to type *quiz feedback*, and optional boxes for the dev to say why. A block already there stays as
# the dev left it. $1: one line per wrong question, its number, a tab and its hint.
feedback() {
  tr -d '\r' < QUIZ.md | WRONG=$1 awk '
    BEGIN {
      n = split(ENVIRON["WRONG"], rows, "\n")
      for (i = 1; i <= n; i++) if (split(rows[i], f, "\t") == 2) hint[f[1]] = f[2]
    }
    function flush(   i, last, block, wrong) {
      for (i = 1; i <= lines; i++) if (buf[i] ~ /^>/) block = 1
      if (!(q in hint) || block) { for (i = 1; i <= lines; i++) print buf[i]; lines = 0; return }
      for (last = lines; last > 0 && buf[last] == ""; last--) ;
      for (i = 1; i <= last; i++) print buf[i]
      wrong = "> Wrong."
      if (hint[q] != "") wrong = wrong " Hint: " hint[q]
      print ""
      print wrong
      print "> Type *quiz feedback* to your agent to talk it through."
      print ">"
      print "> Optional, why? (stays on this machine)"
      print "> - [ ] I had not understood the code"
      print "> - [ ] The question is unclear"
      print "> - [ ] The code does not do what I wanted"
      print "> - Other:"
      if (!end) print ""
      lines = 0
    }
    /^## / { flush(); q++ }
    { buf[++lines] = $0 }
    END { end = 1; flush() }' > QUIZ.tmp
  mv QUIZ.tmp QUIZ.md
}

# Appends to the quiz journal a line per question the dev flagged or commented: v2, the time, the batch's modules, the
# causes, the title and the words. It runs when the quiz passes, when the boxes are the dev's last word. The journal
# stays on this machine, shared by the clone's worktrees; the cockpit reads it.
journal() {
  local file
  file=$(git rev-parse --git-common-dir)/sdd/quiz-journal
  mkdir -p "$(dirname "$file")"
  tr -d '\r' < QUIZ.md | awk -v now="$(date +%s)" -v modules="${hit:--}" '
    function cause(name) { causes = causes (causes == "" ? "" : ",") name }
    function out() {
      if (causes == "" && other == "") return
      gsub(/\t/, " ", title)
      gsub(/\t/, " ", other)
      printf "v2\t%s\t%s\t%s\t%s\t%s\n", now, modules, (causes == "" ? "-" : causes), title, (other == "" ? "-" : other)
    }
    /^## / { out(); title = $0; sub(/^## ([0-9]+\. )?/, "", title); causes = other = ""; next }
    /^> - \[[xX]\] I had not understood/ { cause("not-understood") }
    /^> - \[[xX]\] The question is unclear/ { cause("unclear") }
    /^> - \[[xX]\] The code does not do/ { cause("not-wanted") }
    /^> - Other:/ { other = substr($0, 11); sub(/^[[:space:]]+/, "", other) }
    END { out() }' >> "$file"
}

# Checks the boxes ticked in QUIZ.md against the reviewer's key. Needs changed and hit, set by check.
quiz() {
  local wrong= i boxes ticks pick see right hint
  [ -f QUIZ.md ] ||
    fail 'No quiz for this agent-assisted batch: ask the fresh reviewer for QUIZ.md (see sdd/WORKFLOW.md).'
  quiz_form
  while IFS=$'\t' read -r i boxes ticks pick see right hint; do
    [ "$ticks" -eq 1 ] || fail "Tick exactly one box for question $i in QUIZ.md, save, then commit again."
    [ "$pick" != "$right" ] || continue
    wrong="$wrong$i	$hint
"
    echo "Question $i is wrong: a hint is in QUIZ.md." >&2
  done <<< "$rows"
  if [ -z "$wrong" ]; then
    journal
    return 0
  fi
  feedback "$wrong"
  fail "$((count - $(grep -c . <<< "$wrong")))/$count. Fix your answers in QUIZ.md, save, then commit again."
}

# Drift between contract $2 and the tests it links, in tree $1: a linked file the tree lacks, or a name the file lacks.
links() {
  local link text target path file
  git show "$1:$2" | tr '\r\n' '  ' | tr -s ' ' | grep -o '\[[^]]*\]([^)]*)' | while IFS= read -r link; do
    text=${link#[}
    text=${text%%](*}
    target=${link#*](}
    target=${target%)}
    target=${target%%#*}
    case $target in '' | *:* | *.md | */) continue ;; esac
    # A target is relative to the contract, or starts at the repo root. Resolved here, not by git -C: in a worktree's
    # hook, git -C takes the contract's folder for the work tree.
    case $target in
      /*) path=${target#/} ;;
      *) path=$(PATH_IN="${2%/*}/$target" awk 'BEGIN {
           n = split(ENVIRON["PATH_IN"], part, "/")
           for (i = 1; i <= n; i++) {
             if (part[i] == "..") { if (k == 0) exit; k-- }
             else if (part[i] != "." && part[i] != "") kept[++k] = part[i]
           }
           for (i = 1; i <= k; i++) { out = out sep kept[i]; sep = "/" }
           print out }') ;;
    esac
    file=
    [ -z "$path" ] || file=$(git ls-tree --name-only "$1" -- "$path" 2> /dev/null)
    if [ -z "$file" ]; then
      echo "DRIFT $2: links \"$text\" to $target, a file the commit does not have."
    elif [ "$(git cat-file -t "$1:$file")" = blob ] && [ "$text" != "${file##*/}" ] && [ "$text" != "$file" ] &&
      ! git show "$1:$file" | grep -qwF -- "$text"; then
      echo "DRIFT $2: links \"$text\", not found in $file."
    fi
  done
}

# Guidance for the agent, never a refusal: governs paths that match nothing, and the project's markdown against the
# code it governs (WORKFLOW.md and guide/ are the kit's).
guidance() {
  local contract path paths= md code
  for contract in $(git ls-files 'sdd/modules/*.md'); do
    for path in $(governs ":$contract"); do
      paths="$paths $path"
      [ -n "$(git ls-files -- "$path" | head -n 1)" ] ||
        echo "NOTE $contract: $path matches no tracked file, a typo or code still to come."
    done
  done
  md=$(git grep -I -h -c -v -e '^[[:space:]]*$' -- 'sdd/*.md' AGENTS.md ':!sdd/WORKFLOW.md' ':!sdd/guide/' |
    awk '{ n += $1 } END { print n + 0 }')
  if [ -z "$paths" ]; then
    echo "NOTE $md lines of markdown, no contract yet."
    return
  fi
  code=$(git grep -I -h -c -v -e '^[[:space:]]*$' -- $paths ':!*.md' | awk '{ n += $1 } END { print n + 0 }')
  LC_ALL=C awk -v md="$md" -v code="$code" 'BEGIN {
    printf "NOTE %d lines of markdown for %d lines of governed code, ratio %.2f (guideline: at most 1).\n",
      md, code, code ? md / code : 0 }'
}

hook() {
  local msg base covered total trailer
  # Finishing a merge or a cherry-pick: their commits were checked when first made.
  [ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ] || return 0
  [ ! -f "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ] || return 0
  msg=$(grep -v '^#' "$1" || true)
  base=$(git rev-parse -q --verify HEAD || echo "$EMPTY_TREE")
  check "$base" "$(git write-tree)" "$msg"
  report "$msg" || exit 1
  is_agent "$msg" || return 0
  # A reword or an amend that changes no file leaves nothing to quiz on.
  [ -n "$changed" ] || return 0
  [ "$level" != low ] || [ -f QUIZ.md ] || return 0
  quiz
  read -r covered total <<< "$coverage"
  trailer="Quiz: $count/$count"
  [ "$total" -eq 0 ] || trailer="$trailer, covers $covered/$total"
  git interpret-trailers --in-place --trailer "$trailer" "$1"
  rm -f QUIZ.md "$(quiz_key)"
}

# Without a message file, the batch is judged as an agent's with no trailers.
audit_staged() {
  local msg='Agent-Assisted: yes' base status=0
  [ -z "${1:-}" ] || msg=$(cat "$1")
  base=$(git rev-parse -q --verify HEAD || echo "$EMPTY_TREE")
  check "$base" "$(git write-tree)" "$msg"
  report "$msg" || status=1
  [ -z "$high" ] ||
    echo "NOTE $high: high risk, the quiz cites every hunk of code and a second human's reading is recommended." >&2
  # The reviewer checks its quiz here, so that a malformed one never reaches the human.
  if [ -f QUIZ.md ]; then
    (
      quiz_form
      [ -n "${ranks//${ranks:0:1}/}" ] ||
        echo "NOTE QUIZ.md: the right answer is box ${ranks:0:1} every time, vary it." >&2
      read -r covered total <<< "$coverage"
      [ "$level" != high ] || [ "$covered" -eq "$total" ] ||
        fail "QUIZ.md cites $covered of $total hunks of code; at high risk, its See lines cite them all. Missed: $(
          sed -n 2p <<< "$coverage")."
    ) || status=1
  fi
  [ "$status" -ne 0 ] || echo 'OK: the staged batch passes the checks.'
  guidance
  return $status
}

# CI: each commit of the range, with its own message.
audit_range() {
  local base=${1%%..*} tip=${1#*..} commits c parent msg status=0
  # A base git does not know (a new branch, a force-push) audits the tip only.
  if git cat-file -e "$base^{commit}" 2> /dev/null; then
    commits=$(git rev-list --reverse --no-merges "$1")
  else
    commits=$(git rev-parse "$tip")
  fi
  for c in $commits; do
    # Commits from before the harness was adopted are not its business.
    git cat-file -e "$c:sdd/bin/sdd" 2> /dev/null || continue
    parent=$(git rev-parse -q --verify "$c^" || echo "$EMPTY_TREE")
    msg=$(git log -1 --format=%B "$c")
    check "$parent" "$c" "$msg"
    if report "$msg"; then
      echo "OK   $(git log -1 --format='%h %s' "$c")"
    else
      echo "FAIL $(git log -1 --format='%h %s' "$c")"
      status=1
    fi
  done
  return $status
}

# Runs a command and keeps its output short for the agent: one line when it passes, its last 30 lines when it fails.
quiet() {
  local log status=0
  log=$(mktemp)
  "$@" > "$log" 2>&1 || status=$?
  if [ "$status" -eq 0 ]; then
    echo "ok: $* ($(wc -l < "$log" | tr -d ' ') lines hidden)"
  else
    tail -n 30 "$log"
    echo "FAIL ($status): $*"
  fi
  rm -f "$log"
  return "$status"
}

# Writes hook $1 with line $2, or prints the line for a hook it did not write. The line passes in a repo without the
# script, such as an older branch or another repo sharing the hook.
install_one() {
  local hook
  hook=$(git rev-parse --git-path hooks)/$1
  if git config core.hooksPath > /dev/null || { [ -e "$hook" ] && ! grep -q '^# sdd-fabrik$' "$hook"; }; then
    echo "Your $1 hook is $hook, or the file your hook manager builds it from. Add this line to it:" >&2
    echo "$2" >&2
    return 1
  fi
  mkdir -p "$(dirname "$hook")"
  printf '#!/bin/sh\n# sdd-fabrik\n%s\n' "$2" > "$hook"
  chmod +x "$hook"
  echo "Installed $hook."
}

# What waits for the dev, of address $1: a quiz in another worktree of the clone, then the remote branches not merged
# by another dev, oldest first. It names their author to coordinate, never to measure, and never fetches.
waiting() {
  local top path ref
  top=$(git rev-parse --show-toplevel)
  git worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r path; do
    [ "$path" -ef "$top" ] || [ ! -f "$path/QUIZ.md" ] || echo "A quiz waits for your answers in $path."
  done
  git rev-parse -q --verify refs/remotes/origin/HEAD > /dev/null || return 0
  git for-each-ref --no-merged=origin/HEAD --sort=committerdate --format='%(refname)' refs/remotes/origin |
    while read -r ref; do
      printf '%s\t' "${ref#refs/remotes/}"
      git log -1 --format='%ct%x09%aE%x09%aN' "$ref"
    done |
    NOW=$(date +%s) ME=$1 awk -F '\t' -v wait="$REVIEW_WAIT_HOURS" '
      { hours = int((ENVIRON["NOW"] - $2) / 3600) }
      hours >= wait && tolower($3) != tolower(ENVIRON["ME"]) {
        print $1 " waits for a review for " (hours < 48 ? hours " hours" : int(hours / 24) " days") ", see " $4 "."
      }'
}

# In module $2: when it is the first batch there of the dev of address $1, says so and who delivered there most, by
# name, to know whom to ask. Says nothing in a module the dev knows, or one not committed yet.
newcomer() {
  local contract=sdd/modules/$2.md authors
  git cat-file -e "HEAD:$contract" 2> /dev/null || return 0
  authors=$(git log --no-merges --format='%aE%x09%aN' -- "$contract" $(governs "HEAD:$contract") |
    ME=$1 awk -F '\t' '
      tolower($1) == tolower(ENVIRON["ME"]) { known = 1; exit }
      { n[$2]++ }
      END { if (!known) for (name in n) print n[name] "\t" name }' |
    sort -k1,1nr -k2 | head -n 3 | awk -F '\t' '{ printf "%s%s", sep, $2; sep = ", " }')
  [ -n "$authors" ] || return 0
  echo "First batch of yours in $2."
  echo "Who delivered there most: $authors."
}

# Before a batch, in module $1 if given.
brief() {
  local ident me
  ident=$(git var GIT_AUTHOR_IDENT)
  # Through the mailmap, as %aE is.
  me=$(git check-mailmap "${ident%%>*}>" | sed 's/.*<\(.*\)>/\1/')
  waiting "$me" | head -n 3
  [ -z "$1" ] || newcomer "$me" "$1"
}

# The quiz checks each commit; the token ledger notes each commit and is shared at each push.
install_hook() {
  local exclude status=0
  exclude=$(git rev-parse --git-path info/exclude)
  mkdir -p "$(dirname "$exclude")"
  grep -qx '/QUIZ.md' "$exclude" 2> /dev/null || echo '/QUIZ.md' >> "$exclude"
  install_one commit-msg '[ ! -f sdd/bin/sdd ] || bash sdd/bin/sdd hook "$1" || exit 1' || status=1
  install_one post-commit '[ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger record' || status=1
  install_one pre-push '[ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger sync "$1"' || status=1
  echo 'The token ledger notes what agents spend on each module, never who: git config sdd.ledger false stops it.'
  return $status
}

case ${1:-} in
  hook) hook "$2" ;;
  audit)
    case ${2:-} in
      --message) audit_staged "$3" ;;
      --range) audit_range "$3" ;;
      *) audit_staged ;;
    esac ;;
  fingerprint)
    mkdir -p "$(dirname "$(quiz_key)")"
    echo "fingerprint: $(fingerprint)"
    echo 'quiz: QUIZ.md'
    echo "key: $(quiz_key)" ;;
  install-hook) install_hook ;;
  touched) touched "${2:-HEAD}" ;;
  brief) brief "${2:-}" ;;
  quiet) shift && quiet "$@" ;;
  *)
    echo 'usage: bash sdd/bin/sdd hook <message-file> | audit [--message <file> | --range <base>..<tip>]' >&2
    echo '       bash sdd/bin/sdd fingerprint | install-hook | touched [<commit>] | brief [<module>]' >&2
    echo '       bash sdd/bin/sdd quiet <command>...' >&2
    exit 2 ;;
esac
